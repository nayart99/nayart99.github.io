---
// Owner dashboard: orders, statuses, customer photos. Data comes from the Google Apps Script backend.
// Open with ?demo=1 to see it with sample orders.
import { settings } from '../../lib/site.js';
const cfg = { endpoint: settings.orders_endpoint || '', whatsapp: settings.whatsapp_intl, brand: settings.brand, payNumber: settings.instapay || settings.vodafone_cash || '' };
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <title>لوحة الطلبات | NAY ART</title>
  <meta name="theme-color" content="#7A1F2B" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600&family=Cormorant+Garamond:wght@500;600&display=swap" />
  <style is:inline>
    :root{--cream:#F7F3EC;--paper:#FFFDF9;--sand:#EDE4D8;--ink:#3A1E22;--soft:#6E5A57;--line:#DCCFC0;--wine:#7A1F2B;--wine-d:#5C1620;--blush:#E2B8A8;
      --s-new:#7A1F2B;--s-conf:#2F5D8A;--s-wait:#9A6A12;--s-prep:#6B4FA0;--s-ship:#1F6F78;--s-done:#2E7D4F;--s-cancel:#8C8580;color-scheme:light}
    *{box-sizing:border-box}
    body{margin:0;background:var(--cream);color:var(--ink);font-family:"IBM Plex Sans Arabic","Segoe UI",Tahoma,sans-serif;font-size:15px;line-height:1.6;-webkit-font-smoothing:antialiased}
    button,input,select,textarea{font:inherit;color:inherit}
    button{cursor:pointer}
    [hidden]{display:none!important}
    .wrap{max-width:1180px;margin:0 auto;padding:0 16px}
    .num{font-variant-numeric:tabular-nums;direction:ltr;unicode-bidi:isolate}
    /* login */
    .login{min-height:100vh;display:grid;place-items:center;padding:24px}
    .login form{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:32px 28px;width:min(380px,100%);display:flex;flex-direction:column;gap:14px;box-shadow:0 20px 50px -30px rgba(58,30,34,.4)}
    .login img{width:150px;margin:0 auto 4px}
    .login h1{margin:0;text-align:center;font-size:1.25rem;font-weight:600}
    .login p{margin:0;text-align:center;color:var(--soft);font-size:.9rem}
    .in{width:100%;border:1px solid var(--line);background:#fff;border-radius:10px;padding:11px 14px}
    .in:focus{outline:2px solid var(--wine);outline-offset:1px;border-color:transparent}
    .btn{border:1px solid var(--line);background:var(--paper);border-radius:10px;padding:10px 16px;font-weight:500;display:inline-flex;align-items:center;justify-content:center;gap:8px;text-decoration:none;color:var(--ink);white-space:nowrap}
    .btn:hover{border-color:var(--ink)}
    .btn.p{background:var(--wine);border-color:var(--wine);color:#fff}
    .btn.p:hover{background:var(--wine-d)}
    .btn.wa{background:#1f7a4d;border-color:#1f7a4d;color:#fff}
    .btn svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
    .err{color:var(--wine);font-size:.88rem;text-align:center;min-height:1.2em}
    .chk{display:flex;gap:8px;align-items:center;font-size:.9rem;color:var(--soft)}
    /* top bar */
    header{background:var(--paper);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20}
    header .wrap{display:flex;align-items:center;gap:12px;height:64px}
    header img{height:26px}
    header h1{font-size:1.05rem;margin:0;font-weight:600;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .live{font-size:.8rem;color:var(--soft);display:flex;align-items:center;gap:6px}
    .live i{width:8px;height:8px;border-radius:50%;background:#2E7D4F;display:inline-block;box-shadow:0 0 0 3px rgba(46,125,79,.18)}
    .icon-btn{border:1px solid var(--line);background:var(--paper);border-radius:10px;width:40px;height:40px;display:grid;place-items:center}
    .icon-btn svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8}
    .spin svg{animation:sp 1s linear infinite}@keyframes sp{to{transform:rotate(-360deg)}}
    .demo{background:#FFF4D6;border-bottom:1px solid #EBD9A6;color:#6B5310;font-size:.88rem;text-align:center;padding:8px 16px}
    main{padding:22px 0 60px}
    /* KPIs */
    .kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:22px}
    .kpi{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:16px}
    .kpi span{display:block;color:var(--soft);font-size:.85rem}
    .kpi b{display:block;font-size:1.7rem;font-weight:600;line-height:1.3;margin-top:4px}
    .kpi small{color:var(--soft);font-size:.8rem}
    .kpi.hot{border-color:var(--wine);background:linear-gradient(180deg,#fff,#FBF1EF)}
    .kpi.hot b{color:var(--wine)}
    /* tabs + search */
    .tools{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-bottom:14px}
    .tabs{display:flex;gap:6px;overflow-x:auto;padding-bottom:4px;scrollbar-width:none;max-width:100%}
    .tabs::-webkit-scrollbar{display:none}
    .tab{border:1px solid var(--line);background:var(--paper);border-radius:999px;padding:7px 14px;font-size:.88rem;white-space:nowrap;display:flex;gap:6px;align-items:center}
    .tab[aria-pressed=true]{background:var(--ink);color:#fff;border-color:var(--ink)}
    .tab em{font-style:normal;font-size:.78rem;background:rgba(0,0,0,.07);border-radius:999px;padding:0 7px}
    .tab[aria-pressed=true] em{background:rgba(255,255,255,.2)}
    .search{position:relative;flex:0 1 300px}
    .search .in{padding-inline-start:38px}
    .search svg{position:absolute;inset-inline-start:12px;top:50%;transform:translateY(-50%);width:17px;height:17px;fill:none;stroke:var(--soft);stroke-width:1.8}
    /* orders */
    .list{display:flex;flex-direction:column;gap:10px}
    .ord{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:14px 16px;display:grid;grid-template-columns:56px 1fr auto;gap:14px;align-items:center;cursor:pointer;text-align:start;width:100%;transition:border-color .15s,box-shadow .15s}
    .ord:hover{border-color:var(--ink);box-shadow:0 8px 24px -18px rgba(58,30,34,.5)}
    .ord.fresh{border-color:var(--wine);box-shadow:0 0 0 3px rgba(122,31,43,.12)}
    .th{width:56px;height:56px;border-radius:8px;background:var(--sand);display:grid;place-items:center;overflow:hidden}
    .th img{width:100%;height:100%;object-fit:cover}
    .th svg{width:24px;height:24px;fill:none;stroke:var(--soft);stroke-width:1.5}
    .o-main{min-width:0}
    .o-top{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
    .o-id{font-weight:600}
    .o-time{color:var(--soft);font-size:.82rem}
    .o-who{margin-top:2px}
    .o-items{color:var(--soft);font-size:.88rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .o-end{text-align:end;display:flex;flex-direction:column;gap:6px;align-items:flex-end}
    .o-total{font-weight:600;font-size:1.05rem}
    .pill{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:2px 10px;font-size:.8rem;font-weight:500;color:var(--c);background:color-mix(in srgb,var(--c) 11%,#fff);border:1px solid color-mix(in srgb,var(--c) 28%,#fff);white-space:nowrap}
    .pill::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--c)}
    .tag{font-size:.75rem;border:1px solid var(--line);border-radius:999px;padding:1px 8px;color:var(--soft)}
    .tag.unpaid{color:#8A5A00;background:#FFF4D6;border-color:#EBD9A6;font-weight:600}
    .tag.paid{color:#2E7D4F;background:#EAF5EE;border-color:#BFE0CB}
    .empty{text-align:center;padding:60px 20px;color:var(--soft);background:var(--paper);border:1px dashed var(--line);border-radius:12px}
    .empty b{display:block;color:var(--ink);font-size:1.1rem;margin-bottom:4px}
    /* monthly */
    .month{margin-top:28px;display:grid;grid-template-columns:1.3fr 1fr;gap:12px}
    .card{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:16px 18px}
    .card h2{font-size:1rem;margin:0 0 10px}
    table{width:100%;border-collapse:collapse;font-size:.9rem}
    th,td{text-align:start;padding:8px 6px;border-bottom:1px solid var(--line)}
    th{color:var(--soft);font-weight:500;font-size:.82rem}
    tr:last-child td{border-bottom:0}
    /* detail */
    .scrim{position:fixed;inset:0;background:rgba(40,20,22,.42);z-index:40;opacity:0;pointer-events:none;transition:opacity .2s}
    .scrim.on{opacity:1;pointer-events:auto}
    .panel{position:fixed;top:0;bottom:0;inset-inline-end:0;width:min(560px,100%);background:var(--cream);z-index:41;transform:translateX(-100%);transition:transform .25s ease,visibility .25s;display:flex;flex-direction:column;visibility:hidden}
    [dir=rtl] .panel{inset-inline-end:auto;left:0}
    .panel.on{transform:none;visibility:visible;box-shadow:0 0 40px rgba(0,0,0,.18)}
    .p-head{display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid var(--line);background:var(--paper)}
    .p-head h2{margin:0;font-size:1.1rem;flex:1}
    .p-body{overflow-y:auto;padding:18px;display:flex;flex-direction:column;gap:14px}
    .sec{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:14px 16px}
    .sec h3{margin:0 0 10px;font-size:.85rem;color:var(--soft);font-weight:500}
    .kv{display:grid;grid-template-columns:110px 1fr;gap:6px 10px;font-size:.93rem}
    .kv dt{color:var(--soft)}
    .kv dd{margin:0}
    .acts{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
    .line{display:flex;justify-content:space-between;gap:10px;padding:6px 0;border-bottom:1px dashed var(--line);font-size:.93rem}
    .line:last-child{border-bottom:0}
    .line.t{font-weight:600;font-size:1rem}
    .photos{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
    .ph{border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--sand)}
    .ph .im{aspect-ratio:1;display:grid;place-items:center;background:var(--sand)}
    .ph img{width:100%;height:100%;object-fit:contain;display:block}
    .ph .a{display:flex;gap:6px;padding:8px;flex-wrap:wrap}
    .ph .a .btn{padding:6px 10px;font-size:.8rem;flex:1}
    .row2{display:flex;gap:8px}
    .row2 select{flex:1}
    textarea.in{min-height:80px;resize:vertical}
    .saved{color:#2E7D4F;font-size:.85rem}
    .toast{position:fixed;bottom:20px;left:50%;transform:translate(-50%,20px);background:var(--ink);color:#fff;padding:10px 18px;border-radius:999px;font-size:.9rem;opacity:0;transition:.2s;z-index:60;pointer-events:none}
    .toast.on{opacity:1;transform:translate(-50%,0)}
    .lightbox{position:fixed;inset:0;background:rgba(20,10,12,.88);z-index:70;display:grid;place-items:center;padding:20px}
    .lightbox img{max-width:100%;max-height:86vh;border-radius:6px}
    .lightbox .x{position:absolute;top:16px;left:16px}
    /* views */
    .views{display:flex;gap:4px;background:var(--sand);padding:4px;border-radius:12px;width:max-content;margin-bottom:18px}
    .views button{border:0;background:transparent;padding:8px 18px;border-radius:9px;font-weight:500;color:var(--soft)}
    .views button[aria-pressed=true]{background:var(--paper);color:var(--ink);box-shadow:0 1px 3px rgba(58,30,34,.15)}
    /* filters + bulk */
    .filters{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:12px}
    .filters select,.filters input[type=date]{border:1px solid var(--line);background:#fff;border-radius:9px;padding:8px 10px;font-size:.88rem;max-width:100%}
    .filters .grow{flex:1}
    .filters .btn{padding:8px 12px;font-size:.88rem}
    .selall{display:flex;align-items:center;gap:6px;font-size:.88rem;color:var(--soft)}
    .bulk{position:sticky;top:64px;z-index:15;display:flex;flex-wrap:wrap;gap:8px;align-items:center;background:var(--ink);color:#fff;padding:10px 14px;border-radius:12px;margin-bottom:12px}
    .bulk b{margin-inline-end:6px}
    .bulk select{border:0;border-radius:8px;padding:7px 10px;background:#fff;color:var(--ink)}
    .bulk .btn{padding:7px 12px;font-size:.85rem}
    .ord{grid-template-columns:24px 56px 1fr auto}
    .ord .pick{width:20px;height:20px;accent-color:var(--wine);cursor:pointer}
    .ord.sel{border-color:var(--wine);background:#FBF4F3}
    .count-line{font-size:.85rem;color:var(--soft);margin:0 0 10px}
    /* analytics */
    .seg{display:flex;flex-wrap:wrap;gap:6px}
    .seg button{border:1px solid var(--line);background:var(--paper);border-radius:999px;padding:7px 14px;font-size:.88rem}
    .seg button[aria-pressed=true]{background:var(--ink);color:#fff;border-color:var(--ink)}
    .a-head{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:16px}
    .a-head small{color:var(--soft)}
    .kpis.k8{grid-template-columns:repeat(4,1fr)}
    .delta{display:inline-block;margin-inline-start:6px;font-size:.78rem;color:var(--soft);font-weight:500}
    .agrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .agrid .wide{grid-column:1/-1}
    .card .sub{font-size:.8rem;color:var(--soft);margin:-6px 0 10px}
    .cols{position:relative;display:flex;align-items:flex-end;gap:2px;height:190px;border-bottom:1px solid var(--line);padding-top:8px}
    .cols .c{flex:1;height:100%;display:flex;align-items:flex-end;cursor:default;position:relative;z-index:1}
    .cols .c i{display:block;width:100%;background:var(--wine);border-radius:4px 4px 0 0;min-height:0;transition:opacity .15s}
    .cols .c:hover i{opacity:.75}
    .cols .grid{position:absolute;inset:8px 0 0;pointer-events:none}
    .cols .grid span{position:absolute;left:0;right:0;border-top:1px dashed #EAE1D6;font-size:.7rem;color:var(--soft)}
    .cols .grid span em{position:absolute;inset-inline-start:0;top:-16px;font-style:normal;background:var(--paper);padding:0 4px}
    .xlab{display:flex;justify-content:space-between;font-size:.72rem;color:var(--soft);margin-top:6px}
    .bars{display:flex;flex-direction:column;gap:9px}
    .bar{display:grid;grid-template-columns:minmax(90px,38%) 1fr auto;gap:10px;align-items:center;font-size:.88rem}
    .bar .lab{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .bar .trk{height:10px;background:#F1EAE1;border-radius:99px;overflow:hidden}
    .bar .trk i{display:block;height:100%;background:var(--wine);border-radius:99px}
    .bar .val{color:var(--soft);font-size:.8rem;white-space:nowrap}
    .tip{position:fixed;z-index:80;background:var(--ink);color:#fff;font-size:.82rem;padding:6px 10px;border-radius:8px;pointer-events:none;white-space:nowrap;opacity:0;transition:opacity .1s}
    .tip.on{opacity:1}
    .none{color:var(--soft);font-size:.88rem;padding:10px 0}
    #printArea{display:none}
    @media print{
      body>*:not(#printArea){display:none!important}
      #printArea{display:block!important}
      .lbl{page-break-after:always;border:2px solid #000;padding:18px;font-size:14px;line-height:1.6;color:#000;font-family:"IBM Plex Sans Arabic",Tahoma,sans-serif}
      .lbl h3{margin:0 0 8px;font-size:18px}
      .lbl table{width:100%;border-collapse:collapse;margin-top:10px}
      .lbl td,.lbl th{border:1px solid #999;padding:4px 6px;font-size:13px}
    }
    @media (max-width:860px){.kpis{grid-template-columns:repeat(2,1fr)}.kpis.k8{grid-template-columns:repeat(2,1fr)}.month{grid-template-columns:1fr}.agrid{grid-template-columns:1fr}}
    @media (max-width:560px){
      header h1{font-size:.95rem}.live span{display:none}
      .ord{grid-template-columns:22px 48px 1fr;gap:10px}.th{width:48px;height:48px}
      .o-end{grid-column:1/-1;flex-direction:row;justify-content:space-between;align-items:center;border-top:1px dashed var(--line);padding-top:10px}
      .kpi b{font-size:1.4rem}.search{flex:1 1 100%}.kv{grid-template-columns:95px 1fr}
    }
  </style>
</head>
<body>
  <script type="application/json" id="cfg" set:html={JSON.stringify(cfg)} />

  <section class="login" id="login" hidden>
    <form id="loginForm">
      <img src="/media/brand/logo.png" alt="NAY ART" />
      <h1>لوحة الطلبات</h1>
      <p>خاصة بإدارة NAY ART</p>
      <input class="in" type="password" id="pw" placeholder="كلمة المرور" autocomplete="current-password" required />
      <label class="chk"><input type="checkbox" id="remember" checked /> تذكّرني على هذا الجهاز</label>
      <button class="btn p" type="submit" id="loginBtn">دخول</button>
      <div class="err" id="loginErr"></div>
    </form>
  </section>

  <div id="app" hidden>
    <div class="demo" id="demoBar" hidden>وضع العرض: هذه طلبات تجريبية لمعاينة اللوحة فقط.</div>
    <header><div class="wrap">
      <img src="/media/brand/mark.png" alt="NAY ART" />
      <h1>لوحة الطلبات</h1>
      <div class="live"><i></i><span id="lastSync">متصل</span></div>
      <button class="icon-btn" id="refresh" title="تحديث" aria-label="تحديث"><svg viewBox="0 0 24 24"><path d="M20 11a8 8 0 1 0-2.3 5.7"/><path d="M20 4v7h-7"/></svg></button>
      <button class="icon-btn" id="logout" title="خروج" aria-label="خروج"><svg viewBox="0 0 24 24"><path d="M15 4h4v16h-4"/><path d="M10 8l-4 4 4 4"/><path d="M6 12h10"/></svg></button>
    </div></header>

    <main><div class="wrap">
      <div class="views" role="tablist">
        <button data-view="orders" aria-pressed="true">الطلبات</button>
        <button data-view="analytics" aria-pressed="false">التحليلات</button>
      </div>

      <section id="vOrders">
      <div class="kpis">
        <div class="kpi hot"><span>طلبات جديدة</span><b class="num" id="kNew">0</b><small>بحاجة لتأكيد</small></div>
        <div class="kpi"><span>قيد التنفيذ</span><b class="num" id="kWork">0</b><small>مؤكدة وقيد التجهيز</small></div>
        <div class="kpi"><span>طلبات اليوم</span><b class="num" id="kToday">0</b><small id="kTodaySum">0 ج.م</small></div>
        <div class="kpi"><span>مبيعات هذا الشهر</span><b class="num" id="kMonth">0</b><small id="kMonthN">0 طلب</small></div>
      </div>

      <div class="tools">
        <div class="tabs" id="tabs"></div>
        <label class="search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><input class="in" id="q" type="search" placeholder="ابحث بالاسم أو الموبايل أو رقم الطلب" /></label>
      </div>

      <div class="filters">
        <select id="fRange" aria-label="الفترة">
          <option value="all">كل الفترات</option><option value="today">اليوم</option><option value="7">آخر 7 أيام</option><option value="30">آخر 30 يوم</option><option value="month">هذا الشهر</option><option value="custom">فترة محددة…</option>
        </select>
        <input type="date" id="fFrom" aria-label="من" hidden /><input type="date" id="fTo" aria-label="إلى" hidden />
        <select id="fCity" aria-label="المحافظة"></select>
        <select id="fPay" aria-label="طريقة الدفع"></select>
        <select id="fType" aria-label="النوع"><option value="">كل الأنواع</option><option value="kit">لوحات جاهزة</option><option value="custom">من صورة العميل</option></select>
        <select id="fSrc" aria-label="المصدر"></select>
        <select id="fSort" aria-label="الترتيب"><option value="new">الأحدث أولًا</option><option value="old">الأقدم أولًا</option><option value="high">الأعلى قيمة</option><option value="low">الأقل قيمة</option></select>
        <span class="grow"></span>
        <button class="btn" id="exportCsv" title="يفتح في Excel"><svg viewBox="0 0 24 24"><path d="M12 4v11"/><path d="m7 10 5 5 5-5"/><path d="M5 20h14"/></svg>تصدير Excel</button>
      </div>
      <div class="bulk" id="bulk" hidden>
        <b id="bulkN"></b>
        <select id="bulkStatus" aria-label="الحالة الجديدة"></select>
        <button class="btn p" id="bulkApply">تغيير الحالة</button>
        <button class="btn" id="bulkPrint">طباعة بوالص الشحن</button>
        <button class="btn" id="bulkCsv">تصدير المحدد</button>
        <button class="btn" id="bulkClear">إلغاء التحديد</button>
      </div>
      <p class="count-line"><label class="selall"><input type="checkbox" id="selAll" /> <span id="countLine"></span></label></p>

      <div class="list" id="list"></div>
      </section>

      <section id="vAnalytics" hidden>
        <div class="a-head">
          <div class="seg" id="aRange">
            <button data-r="7">7 أيام</button><button data-r="30" aria-pressed="true">30 يوم</button><button data-r="90">90 يوم</button><button data-r="month">هذا الشهر</button><button data-r="lastmonth">الشهر الماضي</button><button data-r="all">الكل</button>
          </div>
          <small id="aRangeLbl"></small>
        </div>
        <div class="kpis k8" id="aKpis"></div>
        <div class="agrid">
          <div class="card wide"><h2>المبيعات</h2><p class="sub" id="revSub">بالجنيه، بدون الطلبات الملغية</p><div id="chRev"></div></div>
          <div class="card wide"><h2>عدد الطلبات</h2><p class="sub" id="ordSub">بدون الطلبات الملغية</p><div id="chOrd"></div></div>
          <div class="card"><h2>الأكثر مبيعًا</h2><p class="sub">حسب المبيعات</p><div id="bProducts"></div></div>
          <div class="card"><h2>المحافظات</h2><p class="sub">حسب عدد الطلبات</p><div id="bCities"></div></div>
          <div class="card"><h2>مصادر الطلبات</h2><p class="sub">من أين جاء العميل (UTM)</p><div id="bSources"></div></div>
          <div class="card"><h2>طرق الدفع</h2><p class="sub">حسب عدد الطلبات</p><div id="bPay"></div></div>
          <div class="card"><h2>حالة الطلبات</h2><p class="sub">كل طلبات الفترة</p><div id="bStatus"></div></div>
          <div class="card"><h2>أيام الأسبوع</h2><p class="sub">أي يوم بيجيب طلبات أكتر</p><div id="bDow"></div></div>
          <div class="card"><h2>اللوحات الجاهزة مقابل المخصصة</h2><p class="sub">حسب المبيعات</p><div id="bType"></div></div>
          <div class="card"><h2>المقاسات المخصصة</h2><p class="sub">عدد القطع</p><div id="bSizes"></div></div>
          <div class="card wide"><h2>أفضل العملاء</h2><p class="sub">حسب إجمالي الشراء في الفترة</p><table><thead><tr><th>العميل</th><th>الموبايل</th><th>الطلبات</th><th>الإجمالي</th><th>آخر طلب</th></tr></thead><tbody id="cBody"></tbody></table></div>
        </div>
        <div class="month">
          <div class="card"><h2>المبيعات الشهرية</h2><table><thead><tr><th>الشهر</th><th>الطلبات</th><th>المبيعات</th><th>متوسط الطلب</th></tr></thead><tbody id="mBody"></tbody></table></div>
          <div class="card"><h2>الأكثر مبيعًا (كل الوقت)</h2><table><thead><tr><th>اللوحة</th><th>القطع</th><th>المبيعات</th></tr></thead><tbody id="tBody"></tbody></table></div>
        </div>
      </section>
    </div></main>
  </div>

  <div class="scrim" id="scrim"></div>
  <aside class="panel" id="panel" aria-hidden="true">
    <div class="p-head"><h2 id="pTitle"></h2><button class="icon-btn" id="pClose" aria-label="إغلاق"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
    <div class="p-body" id="pBody"></div>
  </aside>
  <div class="toast" id="toast" role="status"></div>
  <div class="tip" id="tip"></div>
  <div id="printArea"></div>

  <script is:inline>
  (() => {
    const CFG = JSON.parse(document.getElementById('cfg').textContent);
    const $ = (id) => document.getElementById(id);
    const DEMO = new URLSearchParams(location.search).has('demo');
    const STATUSES = ['جديد', 'تم التأكيد', 'بانتظار موافقة التصميم', 'قيد التجهيز', 'تم الشحن', 'تم التسليم', 'ملغي'];
    const COLOR = { 'جديد': 'var(--s-new)', 'تم التأكيد': 'var(--s-conf)', 'بانتظار موافقة التصميم': 'var(--s-wait)', 'قيد التجهيز': 'var(--s-prep)', 'تم الشحن': 'var(--s-ship)', 'تم التسليم': 'var(--s-done)', 'ملغي': 'var(--s-cancel)' };
    const WORKING = ['تم التأكيد', 'بانتظار موافقة التصميم', 'قيد التجهيز', 'تم الشحن'];
    const KEY = 'nay-admin-pw';
    let pw = '', orders = [], filter = 'all', seen = new Set(), first = true, openId = null, timer = null;
    const get = (k) => { try { return localStorage.getItem(k) || sessionStorage.getItem(k) || ''; } catch { return ''; } };
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const money = (n) => Number(n || 0).toLocaleString('en-US') + ' ج.م';
    const toast = (m) => { const t = $('toast'); t.textContent = m; t.classList.add('on'); clearTimeout(toast.h); toast.h = setTimeout(() => t.classList.remove('on'), 2200); };
    const pill = (s) => `<span class="pill" style="--c:${COLOR[s] || 'var(--soft)'}">${esc(s)}</span>`;
    const fmtDate = (iso) => { const d = new Date(iso); if (isNaN(d)) return ''; return d.toLocaleString('ar-EG', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' }); };
    const ago = (iso) => { const m = Math.round((Date.now() - new Date(iso)) / 60000); if (m < 1) return 'الآن'; if (m < 60) return `منذ ${m} دقيقة`; const h = Math.round(m / 60); if (h < 24) return `منذ ${h} ساعة`; return fmtDate(iso); };
    const locationLink = (p) => p && Number.isFinite(p.lat) && Number.isFinite(p.lng) && Math.abs(p.lat) <= 90 && Math.abs(p.lng) <= 180 ? 'https://www.google.com/maps?q=' + p.lat + ',' + p.lng : '';
    const intlPhone = (p) => { p = String(p || '').replace(/\D/g, ''); return p.startsWith('0') ? '2' + p : p; };

    async function api(action, extra = {}) {
      if (DEMO) return demoApi(action, extra);
      if (!CFG.endpoint) throw new Error('noendpoint');
      const res = await fetch(CFG.endpoint, { method: 'POST', body: JSON.stringify({ type: 'admin', pw, action, ...extra }) });
      const j = await res.json();
      if (!j.ok) throw new Error(j.error || 'error');
      return j;
    }

    /* ---------- login ---------- */
    async function tryLogin(p, remember) {
      pw = p;
      try {
        const j = await api('list');
        try { (remember ? localStorage : sessionStorage).setItem(KEY, p); } catch {}
        $('login').hidden = true; $('app').hidden = false; $('demoBar').hidden = !DEMO;
        load(j.orders); timer = setInterval(sync, 45000);
        return true;
      } catch (e) {
        const m = e.message;
        $('loginErr').textContent = m === 'auth' ? 'كلمة المرور غير صحيحة.' : m === 'locked' ? 'محاولات كثيرة خاطئة. حاول بعد ١٠ دقائق.' : m === 'noendpoint' ? 'اللوحة لم تُربط بعد بقاعدة الطلبات.' : 'تعذّر الاتصال. تأكد من الإنترنت وحاول مرة أخرى.';
        $('login').hidden = false; $('app').hidden = true;
        return false;
      }
    }
    $('loginForm').addEventListener('submit', async (e) => { e.preventDefault(); const b = $('loginBtn'); b.disabled = true; b.textContent = 'جارٍ الدخول…'; await tryLogin($('pw').value, $('remember').checked); b.disabled = false; b.textContent = 'دخول'; });
    $('logout').addEventListener('click', () => { try { localStorage.removeItem(KEY); sessionStorage.removeItem(KEY); } catch {} location.href = location.pathname; });

    /* ---------- data ---------- */
    async function sync(manual) {
      const r = $('refresh'); r.classList.add('spin');
      try { const j = await api('list'); load(j.orders); if (manual) toast('تم التحديث'); }
      catch (e) { if (e.message === 'auth') { location.reload(); } else if (manual) toast('تعذّر التحديث'); }
      r.classList.remove('spin');
    }
    $('refresh').addEventListener('click', () => sync(true));
    document.addEventListener('visibilitychange', () => { if (!document.hidden && !$('app').hidden) sync(); });

    function load(list) {
      const fresh = [];
      list.forEach((o) => { if (!first && !seen.has(o.id)) fresh.push(o.id); seen.add(o.id); });
      orders = list; first = false;
      if (fresh.length) { toast(fresh.length === 1 ? 'وصل طلب جديد' : `وصلت ${fresh.length} طلبات جديدة`); beep(); }
      $('lastSync').textContent = 'آخر تحديث ' + new Date().toLocaleTimeString('ar-EG', { hour: 'numeric', minute: '2-digit' });
      render(fresh);
      if (openId) { const o = orders.find((x) => x.id === openId); if (o) fillPanelHeader(o); }
    }
    function beep() { try { const a = new (window.AudioContext || window.webkitAudioContext)(), o = a.createOscillator(), g = a.createGain(); o.frequency.value = 880; g.gain.value = .06; o.connect(g); g.connect(a.destination); o.start(); o.stop(a.currentTime + .18); } catch {} }

    let selected = new Set(), view = 'orders', aRange = '30';
    const isCustom = (o) => o.items.some((i) => i.custom);
    const unpaid = (o) => isCustom(o) && o.payment_status !== 'Paid in full' && o.status !== 'ملغي';
    const units = (o) => o.items.reduce((s, i) => s + Number(i.qty || 0), 0);
    const srcLabel = (s) => { s = String(s || '').toLowerCase(); if (!s) return 'مباشر / غير معروف'; if (/^(fb|facebook|meta)/.test(s)) return 'فيسبوك'; if (/^(ig|insta)/.test(s)) return 'إنستجرام'; if (/tiktok/.test(s)) return 'تيك توك'; if (/google/.test(s)) return 'جوجل'; if (/whats/.test(s)) return 'واتساب'; return s; };
    const payLabel = (p) => { p = String(p || ''); if (/cash|نقد|استلام/i.test(p)) return 'الدفع عند الاستلام'; if (/insta/i.test(p)) return 'InstaPay'; if (/voda|فودافون/i.test(p)) return 'فودافون كاش'; return p || 'غير محدد'; };
    const payState = (o) => o.payment_status === 'Paid in full' ? 'مدفوع بالكامل' : isCustom(o) ? 'بانتظار الدفع' : 'غير مؤكد';
    const isCOD = (o) => payLabel(o.payment) === 'الدفع عند الاستلام';
    function rangeBounds(r, from, to) {
      const now = new Date(), sod = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      if (r === 'today') return [sod, null];
      if (r === '7' || r === '30' || r === '90') return [new Date(sod.getTime() - (Number(r) - 1) * 864e5), null];
      if (r === 'month') return [new Date(now.getFullYear(), now.getMonth(), 1), null];
      if (r === 'lastmonth') return [new Date(now.getFullYear(), now.getMonth() - 1, 1), new Date(now.getFullYear(), now.getMonth(), 1)];
      if (r === 'custom') return [from ? new Date(from + 'T00:00:00') : null, to ? new Date(new Date(to + 'T00:00:00').getTime() + 864e5) : null];
      return [null, null];
    }
    const inRange = (o, b) => { const d = new Date(o.date); return (!b[0] || d >= b[0]) && (!b[1] || d < b[1]); };
    function fillSelect(id, label, values) { const el = $(id), cur = el.value; el.innerHTML = `<option value="">${label}</option>` + values.map((v) => `<option ${v === cur ? 'selected' : ''}>${esc(v)}</option>`).join(''); }
    const uniq = (a) => [...new Set(a.filter(Boolean))].sort((x, y) => x.localeCompare(y, 'ar'));

    function filtered() {
      const q = $('q').value.trim().toLowerCase(), b = rangeBounds($('fRange').value, $('fFrom').value, $('fTo').value);
      const city = $('fCity').value, pay = $('fPay').value, type = $('fType').value, src = $('fSrc').value, sort = $('fSort').value;
      const list = orders.filter((o) => (filter === 'all' || (filter === 'unpaid' ? unpaid(o) : o.status === filter)) && inRange(o, b)
        && (!city || o.city === city) && (!pay || payLabel(o.payment) === pay) && (!type || (type === 'custom') === isCustom(o)) && (!src || srcLabel(o.source) === src)
        && (!q || [o.id, o.name, o.phone, o.phone_extra || '', o.city, o.address].join(' ').toLowerCase().includes(q)));
      list.sort((x, y) => sort === 'old' ? new Date(x.date) - new Date(y.date) : sort === 'high' ? y.total - x.total : sort === 'low' ? x.total - y.total : new Date(y.date) - new Date(x.date));
      return list;
    }

    function render(fresh = []) {
      const now = new Date(), today = now.toDateString(), ym = now.toISOString().slice(0, 7);
      const live = orders.filter((o) => o.status !== 'ملغي');
      const newN = orders.filter((o) => o.status === 'جديد').length;
      $('kNew').textContent = newN;
      $('kWork').textContent = orders.filter((o) => WORKING.includes(o.status)).length;
      const td = live.filter((o) => new Date(o.date).toDateString() === today);
      $('kToday').textContent = td.length; $('kTodaySum').textContent = money(td.reduce((s, o) => s + Number(o.total || 0), 0));
      const mo = live.filter((o) => (o.date || '').slice(0, 7) === ym);
      $('kMonth').textContent = Number(mo.reduce((s, o) => s + Number(o.total || 0), 0)).toLocaleString('en-US'); $('kMonthN').textContent = `جنيه مصري · ${mo.length} ${mo.length > 2 && mo.length < 11 ? 'طلبات' : 'طلب'}`;
      document.title = (newN ? `(${newN}) ` : '') + 'لوحة الطلبات | NAY ART';

      const counts = { all: orders.length, unpaid: orders.filter(unpaid).length }; STATUSES.forEach((s) => counts[s] = orders.filter((o) => o.status === s).length);
      $('tabs').innerHTML = [['all', 'الكل'], ['unpaid', 'بانتظار الدفع'], ...STATUSES.map((s) => [s, s])].map(([k, l]) => `<button class="tab" data-f="${esc(k)}" aria-pressed="${filter === k}">${esc(l)} <em class="num">${counts[k] || 0}</em></button>`).join('');
      fillSelect('fCity', 'كل المحافظات', uniq(orders.map((o) => o.city)));
      fillSelect('fPay', 'كل طرق الدفع', uniq(orders.map((o) => payLabel(o.payment))));
      fillSelect('fSrc', 'كل المصادر', uniq(orders.map((o) => srcLabel(o.source))));

      const shown = filtered();
      const ids = new Set(orders.map((o) => o.id)); [...selected].forEach((id) => { if (!ids.has(id)) selected.delete(id); });
      $('countLine').textContent = `${shown.length} طلب · ${money(shown.filter((o) => o.status !== 'ملغي').reduce((s, o) => s + Number(o.total || 0), 0))}`;
      $('selAll').checked = shown.length > 0 && shown.every((o) => selected.has(o.id));
      $('list').innerHTML = shown.length ? shown.map((o) => {
        const custom = isCustom(o), sel = selected.has(o.id);
        const th = o.photos[0]?.thumb ? `<img src="${o.photos[0].thumb}" alt="">` : `<svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="1"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>`;
        const items = o.items.map((i) => `${i.name}${i.option ? ' (' + i.option + ')' : ''} × ${i.qty}`).join('، ');
        return `<div class="ord${fresh.includes(o.id) ? ' fresh' : ''}${sel ? ' sel' : ''}" data-id="${esc(o.id)}" tabindex="0" role="button">
          <input type="checkbox" class="pick" data-pick="${esc(o.id)}" ${sel ? 'checked' : ''} aria-label="تحديد ${esc(o.id)}">
          <div class="th">${th}</div>
          <div class="o-main"><div class="o-top"><span class="o-id num">${esc(o.id)}</span><span class="o-time">${ago(o.date)}</span>${custom ? '<span class="tag">من صورة العميل</span>' : ''}${unpaid(o) ? '<span class="tag unpaid">بانتظار الدفع</span>' : (custom && o.payment_status === 'Paid in full' ? '<span class="tag paid">تم الدفع</span>' : '')}</div>
            <div class="o-who">${esc(o.name)} · ${esc(o.city)}</div><div class="o-items">${esc(items)}</div></div>
          <div class="o-end"><span class="o-total num">${money(o.total)}</span>${pill(o.status)}</div></div>`;
      }).join('') : `<div class="empty"><b>${orders.length ? 'لا توجد طلبات هنا' : 'لا توجد طلبات بعد'}</b>${orders.length ? 'جرّب فلتر آخر أو امسح البحث.' : 'أول ما يطلب عميل من الموقع، سيظهر الطلب هنا فورًا.'}</div>`;
      renderBulk();
      if (view === 'analytics') renderAnalytics();
    }

    function renderBulk() {
      const n = selected.size; $('bulk').hidden = !n;
      if (!n) return;
      $('bulkN').textContent = `${n} طلب محدد`;
      if (!$('bulkStatus').options.length) $('bulkStatus').innerHTML = STATUSES.map((s) => `<option>${s}</option>`).join('');
    }

    $('tabs').addEventListener('click', (e) => { const b = e.target.closest('[data-f]'); if (b) { filter = b.dataset.f; render(); } });
    $('q').addEventListener('input', () => render());
    ['fCity', 'fPay', 'fType', 'fSrc', 'fSort', 'fFrom', 'fTo'].forEach((id) => $(id).addEventListener('change', () => render()));
    $('fRange').addEventListener('change', () => { const c = $('fRange').value === 'custom'; $('fFrom').hidden = !c; $('fTo').hidden = !c; render(); });
    $('list').addEventListener('click', (e) => {
      const pick = e.target.closest('[data-pick]');
      if (pick) { const id = pick.dataset.pick; pick.checked ? selected.add(id) : selected.delete(id); pick.closest('.ord').classList.toggle('sel', pick.checked); $('selAll').checked = filtered().every((o) => selected.has(o.id)); renderBulk(); return; }
      const b = e.target.closest('[data-id]'); if (b) openPanel(b.dataset.id);
    });
    $('list').addEventListener('keydown', (e) => { if (e.key === 'Enter' && e.target.matches('.ord')) openPanel(e.target.dataset.id); });
    $('selAll').addEventListener('change', (e) => { const list = filtered(); list.forEach((o) => e.target.checked ? selected.add(o.id) : selected.delete(o.id)); render(); });
    $('bulkClear').addEventListener('click', () => { selected.clear(); render(); });
    $('bulkApply').addEventListener('click', async () => {
      const s = $('bulkStatus').value, ids = [...selected]; if (!ids.length) return;
      if (!confirm(`تغيير حالة ${ids.length} طلب إلى «${s}»؟`)) return;
      const b = $('bulkApply'); b.disabled = true; let ok = 0, blocked = 0, fail = 0;
      for (const id of ids) {
        b.textContent = `جارٍ التحديث ${ok + blocked + fail + 1}/${ids.length}`;
        try { await api('update', { id, status: s }); const o = orders.find((x) => x.id === id); if (o) { o.status = s; o.updated = new Date().toISOString(); } ok++; }
        catch (e) { e.message === 'payment_required' ? blocked++ : fail++; }
      }
      b.disabled = false; b.textContent = 'تغيير الحالة'; selected.clear(); render();
      toast(`تم تحديث ${ok} طلب` + (blocked ? ` · ${blocked} بانتظار تأكيد الدفع` : '') + (fail ? ` · ${fail} تعذّر` : ''));
    });
    const pickedOrders = () => orders.filter((o) => selected.has(o.id));
    $('bulkPrint').addEventListener('click', () => printLabels(pickedOrders()));
    $('bulkCsv').addEventListener('click', () => downloadCsv(pickedOrders(), 'selected'));
    $('exportCsv').addEventListener('click', () => { const l = filtered(); if (!l.length) return toast('لا توجد طلبات للتصدير'); downloadCsv(l, 'orders'); });

    /* ---------- export + print ---------- */
    function downloadCsv(list, tag) {
      const cols = [['رقم الطلب', (o) => o.id], ['التاريخ', (o) => new Date(o.date).toLocaleString('en-GB')], ['الحالة', (o) => o.status], ['حالة الدفع', payState],
        ['الاسم', (o) => o.name], ['الموبايل', (o) => '="' + (o.phone || '') + '"'], ['موبايل إضافي', (o) => o.phone_extra ? '="' + o.phone_extra + '"' : ''], ['المحافظة', (o) => o.city], ['العنوان', (o) => o.address], ['موقع التوصيل', (o) => locationLink(o.location)],
        ['المنتجات', (o) => o.items.map((i) => `${i.name}${i.option ? ' (' + i.option + ')' : ''} × ${i.qty}`).join(' | ')], ['القطع', units], ['المجموع', (o) => o.subtotal], ['التوصيل', (o) => o.delivery], ['الإجمالي', (o) => o.total],
        ['طريقة الدفع', (o) => payLabel(o.payment)], ['المصدر', (o) => srcLabel(o.source)], ['الحملة', (o) => o.campaign || ''], ['ملاحظات العميل', (o) => o.notes || ''], ['ملاحظات داخلية', (o) => o.internal || '']];
      const q = (v) => { v = String(v == null ? '' : v); return /[",\n\r]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v; };
      const csv = '﻿' + [cols.map((c) => q(c[0])).join(','), ...list.map((o) => cols.map((c) => q(c[1](o))).join(','))].join('\r\n');
      const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
      a.download = `nay-art-${tag}-${new Date().toISOString().slice(0, 10)}.csv`; document.body.appendChild(a); a.click(); a.remove();
      toast(`تم تصدير ${list.length} طلب`);
    }
    function printLabels(list) {
      if (!list.length) return;
      $('printArea').innerHTML = list.map((o) => `<div class="lbl"><h3>NAY ART · طلب ${esc(o.id)}</h3>
        <div><b>العميل:</b> ${esc(o.name)}</div><div><b>الموبايل:</b> ${esc(o.phone)}${o.phone_extra ? ' / ' + esc(o.phone_extra) : ''}</div>
        <div><b>المحافظة:</b> ${esc(o.city)}</div><div><b>العنوان:</b> ${esc(o.address)}</div>${locationLink(o.location) ? `<div><b>الموقع:</b> ${locationLink(o.location)}</div>` : ''}
        <table><tr><th>المنتج</th><th>الكمية</th><th>السعر</th></tr>${o.items.map((i) => `<tr><td>${esc(i.name)}${i.option ? ' (' + esc(i.option) + ')' : ''}</td><td>${i.qty}</td><td>${money(i.line)}</td></tr>`).join('')}
        <tr><td>التوصيل</td><td></td><td>${money(o.delivery)}</td></tr><tr><th>الإجمالي</th><th></th><th>${money(o.total)}</th></tr></table>
