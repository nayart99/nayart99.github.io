---
// Instagram / Facebook / TikTok icon links. Links come from Settings → Social media links.
import { settings } from '../lib/site.js';
const { cls = 'social' } = Astro.props;
const s = settings.social || {};
const items = [
  { key: 'instagram', label: 'Instagram', path: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r=".9" fill="currentColor" stroke="none"/>' },
  { key: 'facebook', label: 'Facebook', path: '<path d="M14 21v-8h2.8l.4-3.2H14V7.9c0-.9.3-1.6 1.6-1.6h1.7V3.4c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.3v2.2H8v3.2h2.7v8"/>' },
  { key: 'tiktok', label: 'TikTok', path: '<path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.4 2.6 2.2 4.4 5 4.6"/>' },
].filter((i) => s[i.key]);
---
{items.length > 0 && (
  <div class={cls}>
    {items.map((i) => (
      <a href={s[i.key]} target="_blank" rel="noopener" aria-label={i.label} title={i.label}>
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={i.path} />
      </a>
    ))}
  </div>
)}
