    let couriers = ['Run', 'Bosta', 'Taslem Mobasher'];
    const SHIP_STATES = ['تم الشحن', 'تم التسليم'], NO_SHIP = 'بدون شركة شحن';
    const WORKING = ['تم التأكيد', 'بانتظار موافقة التصميم', 'قيد التجهيز', 'تم الشحن'];
    const KEY = 'nay-admin-pw';
    let pw = '', orders = [], filter = 'all', seen = new Set(), first = true, openId = null, timer = null;
    const get = (k) => { try { return localStorage.getItem(k) || sessionStorage.getItem(k) || ''; } catch { return ''; } };
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const money = (n) => Number(n || 0).toLocaleString('en-US') + ' ج.م';
    const toast = (m) => { const t = $('toast'); t.textContent = m; t.classList.add('on'); clearTimeout(toast.h); toast.h = setTimeout(() => t.classList.remove('on'), 2200); };
    const pill = (s) => `<span class="pill" style="--c:${COLOR[s] || 'var(--soft)'}">${esc(s)}</span>`;
    const fmtDate = (iso) => { const d = new Date(iso); if (isNaN(d)) return ''; return d.toLocaleString('ar-EG', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' }); };
    const ago = (iso) => { const m = Math.round((Date.now() - new Date(iso)) / 60000); if (m < 1) return 'الآن'; if (m < 60) return `منذ ${m} دقيقة`; const h = Math.round(m / 60); if (h < 24) return `منذ ${h} ساعة`; return fmtDate(iso); };
    const locationLink = (p) => p && Number.isFinite(p.lat) && Number.isFinite(p.lng) && Math.abs(p.lat) <= 90 && Math.abs(p.lng) <= 180 ? 'https://www.google.com/maps?q=' + p.lat + ',' + p.lng : '';
    const intlPhone = (p) => { p = String(p || '').replace(/\D/g, ''); return p.startsWith('0') ? '2' + p : p; };

    async function api(action, extra = {}) {
      if (DEMO) return demoApi(action, extra);
      if (!CFG.endpoint) throw new Error('noendpoint');
      const res = await fetch(CFG.endpoint, { method: 'POST', body: JSON.stringify({ type: 'admin', pw, action, ...extra }) });
      const j = await res.json();
      if (!j.ok) throw new Error(j.error || 'error');
      return j;
    }

    /* ---------- login ---------- */
    async function tryLogin(p, remember) {
      pw = p;
      try {
        const j = await api('list');
        try { (remember ? localStorage : sessionStorage).setItem(KEY, p); } catch {}
        $('login').hidden = true; $('app').hidden = false; $('demoBar').hidden = !DEMO;
        if (!DEMO) try { localStorage.setItem('nay-owner', '1'); } catch {} // the owner's own visits to the website are not counted
        if (j.couriers) couriers = j.couriers; load(j.orders); timer = setInterval(sync, 45000);
        return true;
      } catch (e) {
        const m = e.message;
        $('loginErr').textContent = m === 'auth' ? 'كلمة المرور غير صحيحة.' : m === 'locked' ? 'محاولات كثيرة خاطئة. حاول بعد ١٠ دقائق.' : m === 'noendpoint' ? 'اللوحة لم تُربط بعد بقاعدة الطلبات.' : 'تعذّر الاتصال. تأكد من الإنترنت وحاول مرة أخرى.';
        $('login').hidden = false; $('app').hidden = true;
        return false;
      }
    }
    $('loginForm').addEventListener('submit', async (e) => { e.preventDefault(); const b = $('loginBtn'); b.disabled = true; b.textContent = 'جارٍ الدخول…'; await tryLogin($('pw').value, $('remember').checked); b.disabled = false; b.textContent = 'دخول'; });
    $('logout').addEventListener('click', () => { try { localStorage.removeItem(KEY); sessionStorage.removeItem(KEY); } catch {} location.href = location.pathname; });

    /* ---------- data ---------- */
    async function sync(manual) {
      const r = $('refresh'); r.classList.add('spin');
      try { const j = await api('list'); if (j.couriers) couriers = j.couriers; load(j.orders); if (manual) toast('تم التحديث'); }
      catch (e) { if (e.message === 'auth') { location.reload(); } else if (manual) toast('تعذّر التحديث'); }
      r.classList.remove('spin');
    }
    $('refresh').addEventListener('click', () => sync(true));
    document.addEventListener('visibilitychange', () => { if (!document.hidden && !$('app').hidden) sync(); });

    function load(list) {
      const fresh = [];
      list.forEach((o) => { if (!first && !seen.has(o.id)) fresh.push(o.id); seen.add(o.id); });
      orders = list; first = false;
      if (fresh.length) { toast(fresh.length === 1 ? 'وصل طلب جديد' : `وصلت ${fresh.length} طلبات جديدة`); beep(); }
      $('lastSync').textContent = 'آخر تحديث ' + new Date().toLocaleTimeString('ar-EG', { hour: 'numeric', minute: '2-digit' });
      render(fresh);
      if (openId) { const o = orders.find((x) => x.id === openId); if (o) fillPanelHeader(o); }
    }
    function beep() { try { const a = new (window.AudioContext || window.webkitAudioContext)(), o = a.createOscillator(), g = a.createGain(); o.frequency.value = 880; g.gain.value = .06; o.connect(g); g.connect(a.destination); o.start(); o.stop(a.currentTime + .18); } catch {} }

    let selected = new Set(), view = 'orders', aRange = '30';
    const isCustom = (o) => o.items.some((i) => i.custom);
    const online = (o) => /Kashier|أونلاين|online/i.test(o.payment || '') || o.payment_status === 'Awaiting online payment';
    const transferPay = (o) => /insta|voda|فودافون/i.test(o.payment || '');
    const review = (o) => o.payment_status === 'Transfer submitted' && o.status !== 'ملغي';
    const unpaid = (o) => (isCustom(o) || online(o) || transferPay(o)) && o.payment_status !== 'Paid in full' && o.status !== 'ملغي';
    const units = (o) => o.items.reduce((s, i) => s + Number(i.qty || 0), 0);
    const srcLabel = (s) => { s = String(s || '').toLowerCase(); if (!s) return 'مباشر / غير معروف'; if (/^(fb|facebook|meta)/.test(s)) return 'فيسبوك'; if (/^(ig|insta)/.test(s)) return 'إنستجرام'; if (/tiktok/.test(s)) return 'تيك توك'; if (/google/.test(s)) return 'جوجل'; if (/whats/.test(s)) return 'واتساب'; return s; };
    const payKind = (p) => { p = String(p || ''); if (/kashier|أونلاين|online/i.test(p)) return 'kashier'; if (/voda|فودافون/i.test(p)) return 'vodafone'; if (/insta/i.test(p)) return 'instapay'; if (/^cod$|cash|نقد|استلام/i.test(p)) return 'cod'; return ''; };
    const PAY_NAMES = { kashier: 'أونلاين (كارت/محفظة)', cod: 'الدفع عند الاستلام', instapay: 'InstaPay', vodafone: 'فودافون كاش' };
    const payLabel = (p) => PAY_NAMES[payKind(p)] || String(p || '') || 'غير محدد';
    const payState = (o) => o.payment_status === 'Paid in full' ? 'مدفوع بالكامل' + (o.payment_ref ? ' · ' + o.payment_ref : '') : o.payment_status === 'Awaiting online payment' ? 'لم يكمل الدفع الأونلاين' : o.payment_status === 'Transfer submitted' ? 'تحويل بانتظار المراجعة' : unpaid(o) ? 'بانتظار الدفع' : 'غير مؤكد';
    const isCOD = (o) => payLabel(o.payment) === 'الدفع عند الاستلام';
    function rangeBounds(r, from, to) {
      const now = new Date(), sod = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      if (r === 'today') return [sod, null];
      if (r === '7' || r === '30' || r === '90') return [new Date(sod.getTime() - (Number(r) - 1) * 864e5), null];
      if (r === 'month') return [new Date(now.getFullYear(), now.getMonth(), 1), null];
      if (r === 'lastmonth') return [new Date(now.getFullYear(), now.getMonth() - 1, 1), new Date(now.getFullYear(), now.getMonth(), 1)];
      if (r === 'custom') return [from ? new Date(from + 'T00:00:00') : null, to ? new Date(new Date(to + 'T00:00:00').getTime() + 864e5) : null];
      return [null, null];
    }
    const inRange = (o, b) => { const d = new Date(o.date); return (!b[0] || d >= b[0]) && (!b[1] || d < b[1]); };
    function fillSelect(id, label, values) { const el = $(id), cur = el.value; el.innerHTML = `<option value="">${label}</option>` + values.map((v) => `<option ${v === cur ? 'selected' : ''}>${esc(v)}</option>`).join(''); }
    const uniq = (a) => [...new Set(a.filter(Boolean))].sort((x, y) => x.localeCompare(y, 'ar'));

    function filtered() {
      const q = $('q').value.trim().toLowerCase(), b = rangeBounds($('fRange').value, $('fFrom').value, $('fTo').value);
      const city = $('fCity').value, pay = $('fPay').value, ship = $('fShip').value, type = $('fType').value, src = $('fSrc').value, sort = $('fSort').value;
      const list = orders.filter((o) => (filter === 'all' || (filter === 'unpaid' ? unpaid(o) : filter === 'review' ? review(o) : o.status === filter)) && inRange(o, b)
        && (!city || o.city === city) && (!pay || payLabel(o.payment) === pay) && (!ship || (ship === NO_SHIP ? !o.courier : o.courier === ship)) && (!type || (type === 'custom') === isCustom(o)) && (!src || srcLabel(o.source) === src)
        && (!q || [o.id, o.name, o.phone, o.phone_extra || '', o.city, o.address].join(' ').toLowerCase().includes(q)));
      list.sort((x, y) => sort === 'old' ? new Date(x.date) - new Date(y.date) : sort === 'high' ? y.total - x.total : sort === 'low' ? x.total - y.total : new Date(y.date) - new Date(x.date));
      return list;
    }

    function render(fresh = []) {
      const now = new Date(), today = now.toDateString(), ym = now.toISOString().slice(0, 7);
      const live = orders.filter((o) => o.status !== 'ملغي');
      const newN = orders.filter((o) => o.status === 'جديد').length;
      $('kNew').textContent = newN;
      $('kWork').textContent = orders.filter((o) => WORKING.includes(o.status)).length;
      const td = live.filter((o) => new Date(o.date).toDateString() === today);
      $('kToday').textContent = td.length; $('kTodaySum').textContent = money(td.reduce((s, o) => s + Number(o.total || 0), 0));
      const mo = live.filter((o) => (o.date || '').slice(0, 7) === ym);
      $('kMonth').textContent = Number(mo.reduce((s, o) => s + Number(o.total || 0), 0)).toLocaleString('en-US'); $('kMonthN').textContent = `جنيه مصري · ${mo.length} ${mo.length > 2 && mo.length < 11 ? 'طلبات' : 'طلب'}`;
      document.title = (newN ? `(${newN}) ` : '') + 'لوحة الطلبات | NAY ART';

      const counts = { all: orders.length, unpaid: orders.filter(unpaid).length, review: orders.filter(review).length }; STATUSES.forEach((s) => counts[s] = orders.filter((o) => o.status === s).length);
      $('tabs').innerHTML = [['all', 'الكل'], ['review', 'تحويلات للمراجعة'], ['unpaid', 'بانتظار الدفع'], ...STATUSES.map((s) => [s, s])].map(([k, l]) => `<button class="tab" data-f="${esc(k)}" aria-pressed="${filter === k}">${esc(l)} <em class="num">${counts[k] || 0}</em></button>`).join('');
      fillSelect('fCity', 'كل المحافظات', uniq(orders.map((o) => o.city)));
      fillSelect('fPay', 'كل طرق الدفع', uniq(orders.map((o) => payLabel(o.payment))));
      fillSelect('fShip', 'كل شركات الشحن', [...new Set([...couriers, ...orders.map((o) => o.courier).filter(Boolean)]), NO_SHIP]);
      fillSelect('fSrc', 'كل المصادر', uniq(orders.map((o) => srcLabel(o.source))));

      const shown = filtered();
      const ids = new Set(orders.map((o) => o.id)); [...selected].forEach((id) => { if (!ids.has(id)) selected.delete(id); });
      $('countLine').textContent = `${shown.length} طلب · ${money(shown.filter((o) => o.status !== 'ملغي').reduce((s, o) => s + Number(o.total || 0), 0))}`;
      $('selAll').checked = shown.length > 0 && shown.every((o) => selected.has(o.id));
      $('list').innerHTML = shown.length ? shown.map((o) => {
        const custom = isCustom(o), sel = selected.has(o.id);
        const th = o.photos[0]?.thumb ? `<img src="${o.photos[0].thumb}" alt="">` : `<svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="1"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>`;
        const items = o.items.map((i) => `${i.name}${i.option ? ' (' + i.option + ')' : ''} × ${i.qty}`).join('، ');
        return `<div class="ord${fresh.includes(o.id) ? ' fresh' : ''}${sel ? ' sel' : ''}" data-id="${esc(o.id)}" tabindex="0" role="button">
          <input type="checkbox" class="pick" data-pick="${esc(o.id)}" ${sel ? 'checked' : ''} aria-label="تحديد ${esc(o.id)}">
          <div class="th">${th}</div>
          <div class="o-main"><div class="o-top"><span class="o-id num">${esc(o.id)}</span><span class="o-time">${ago(o.date)}</span>${o.courier ? `<span class="tag ship">🚚 ${esc(o.courier)}</span>` : ''}${custom ? '<span class="tag">من صورة العميل</span>' : ''}${dState(o) === 'ready' ? '<span class="tag dsg">🎨 ملف الطباعة جاهز</span>' : dState(o) === 'pending' ? '<span class="tag dsg-w">⏳ جارٍ التصميم</span>' : dState(o) === 'failed' ? '<span class="tag flag">التصميم فشل</span>' : ''}${review(o) && flagLvl(o) === 'bad' ? '<span class="tag flag">🔴 صورة التحويل فيها مشكلة</span>' : review(o) ? '<span class="tag review">💳 تحويل بانتظار المراجعة</span>' : unpaid(o) ? `<span class="tag unpaid">${online(o) ? 'لم يكمل الدفع الأونلاين' : 'بانتظار الدفع'}</span>` : ((custom || online(o) || transferPay(o)) && o.payment_status === 'Paid in full' ? `<span class="tag paid">${online(o) ? 'مدفوع أونلاين' : 'تم الدفع'}</span>` : '')}</div>
            <div class="o-who">${esc(o.name)} · ${esc(o.city)}</div><div class="o-items">${esc(items)}</div></div>
          <div class="o-end"><span class="o-total num">${money(o.total)}</span>${pill(o.status)}</div></div>`;
      }).join('') : `<div class="empty"><b>${orders.length ? 'لا توجد طلبات هنا' : 'لا توجد طلبات بعد'}</b>${orders.length ? 'جرّب فلتر آخر أو امسح البحث.' : 'أول ما يطلب عميل من الموقع، سيظهر الطلب هنا فورًا.'}</div>`;
      renderBulk();
      if (view === 'analytics') renderAnalytics();
    }

    function renderBulk() {
      const n = selected.size; $('bulk').hidden = !n;
      if (!n) return;
      $('bulkN').textContent = `${n} طلب محدد`;
      if (!$('bulkStatus').options.length) $('bulkStatus').innerHTML = STATUSES.map((s) => `<option>${s}</option>`).join('');
    }

    $('tabs').addEventListener('click', (e) => { const b = e.target.closest('[data-f]'); if (b) { filter = b.dataset.f; render(); } });
    $('q').addEventListener('input', () => render());
    ['fCity', 'fPay', 'fShip', 'fType', 'fSrc', 'fSort', 'fFrom', 'fTo'].forEach((id) => $(id).addEventListener('change', () => render()));
    $('fRange').addEventListener('change', () => { const c = $('fRange').value === 'custom'; $('fFrom').hidden = !c; $('fTo').hidden = !c; render(); });
    $('list').addEventListener('click', (e) => {
      const pick = e.target.closest('[data-pick]');
      if (pick) { const id = pick.dataset.pick; pick.checked ? selected.add(id) : selected.delete(id); pick.closest('.ord').classList.toggle('sel', pick.checked); $('selAll').checked = filtered().every((o) => selected.has(o.id)); renderBulk(); return; }
      const b = e.target.closest('[data-id]'); if (b) openPanel(b.dataset.id);
    });
    $('list').addEventListener('keydown', (e) => { if (e.key === 'Enter' && e.target.matches('.ord')) openPanel(e.target.dataset.id); });
    $('selAll').addEventListener('change', (e) => { const list = filtered(); list.forEach((o) => e.target.checked ? selected.add(o.id) : selected.delete(o.id)); render(); });
    $('bulkClear').addEventListener('click', () => { selected.clear(); render(); });
    async function archive(ids) {
      if (!ids.length) return false;
      if (!confirm(`حذف ${ids.length} طلب من اللوحة؟\nهتتنقل لشيت «Archived orders» في Google Sheets ومش هتظهر في اللوحة ولا التحليلات.`)) return false;
      try { const j = await api('archive', { ids }); orders = orders.filter((o) => !ids.includes(o.id)); ids.forEach((id) => selected.delete(id)); render(); toast(`تم حذف ${j.archived ?? ids.length} طلب من اللوحة`); return true; }
      catch (e) { toast(e.message === 'unknown action' ? 'الحذف محتاج تحديث خدمة الطلبات' : 'تعذّر الحذف'); return false; }
    }
    $('bulkArchive').addEventListener('click', () => archive([...selected]));
    $('bulkApply').addEventListener('click', async () => {
      const s = $('bulkStatus').value, ids = [...selected]; if (!ids.length) return;
      if (!confirm(`تغيير حالة ${ids.length} طلب إلى «${s}»؟`)) return;
      let courier;
      const noC = ids.filter((id) => !(orders.find((x) => x.id === id) || {}).courier);
      if (SHIP_STATES.includes(s) && noC.length) { courier = await chooseCourier(`${noC.length} طلب من دول من غير شركة شحن، مع أنهي شركة؟`); if (courier === undefined) return; }
      const b = $('bulkApply'); b.disabled = true; let ok = 0, blocked = 0, fail = 0;
      for (const id of ids) {
        b.textContent = `جارٍ التحديث ${ok + blocked + fail + 1}/${ids.length}`;
        const setC = courier && noC.includes(id);
        try { await api('update', { id, status: s, ...(setC ? { courier } : {}) }); const o = orders.find((x) => x.id === id); if (o) { o.status = s; if (setC) noteCourier(o, courier); o.updated = new Date().toISOString(); } ok++; }
        catch (e) { e.message === 'payment_required' ? blocked++ : fail++; }
      }
      b.disabled = false; b.textContent = 'تغيير الحالة'; selected.clear(); render();
      toast(`تم تحديث ${ok} طلب` + (blocked ? ` · ${blocked} بانتظار تأكيد الدفع` : '') + (fail ? ` · ${fail} تعذّر` : ''));
    });
    const pickedOrders = () => orders.filter((o) => selected.has(o.id));
    $('bulkPrint').addEventListener('click', () => printLabels(pickedOrders()));
    $('bulkCsv').addEventListener('click', () => downloadCsv(pickedOrders(), 'selected'));
    $('exportCsv').addEventListener('click', () => { const l = filtered(); if (!l.length) return toast('لا توجد طلبات للتصدير'); downloadCsv(l, 'orders'); });

    /* ---------- export + print ---------- */
    function downloadCsv(list, tag) {
      const cols = [['رقم الطلب', (o) => o.id], ['التاريخ', (o) => new Date(o.date).toLocaleString('en-GB')], ['الحالة', (o) => o.status], ['حالة الدفع', payState],
        ['الاسم', (o) => o.name], ['الموبايل', (o) => '="' + (o.phone || '') + '"'], ['موبايل إضافي', (o) => o.phone_extra ? '="' + o.phone_extra + '"' : ''], ['المحافظة', (o) => o.city], ['العنوان', (o) => o.address], ['موقع التوصيل', (o) => locationLink(o.location)],
        ['المنتجات', (o) => o.items.map((i) => `${i.name}${i.option ? ' (' + i.option + ')' : ''} × ${i.qty}`).join(' | ')], ['القطع', units], ['المجموع', (o) => o.subtotal], ['التوصيل', (o) => o.delivery], ['الإجمالي', (o) => o.total],
        ['طريقة الدفع', (o) => payLabel(o.payment)], ['شركة الشحن', (o) => o.courier || ''], ['المصدر', (o) => srcLabel(o.source)], ['الحملة', (o) => o.campaign || ''], ['ملاحظات العميل', (o) => o.notes || ''], ['ملاحظات داخلية', (o) => o.internal || '']];
      const q = (v) => { v = String(v == null ? '' : v); return /[",\n\r]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v; };
      const csv = '﻿' + [cols.map((c) => q(c[0])).join(','), ...list.map((o) => cols.map((c) => q(c[1](o))).join(','))].join('\r\n');
      const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
      a.download = `nay-art-${tag}-${new Date().toISOString().slice(0, 10)}.csv`; document.body.appendChild(a); a.click(); a.remove();
      toast(`تم تصدير ${list.length} طلب`);
    }
    function printLabels(list) {
      if (!list.length) return;
      $('printArea').innerHTML = list.map((o) => `<div class="lbl"><h3>NAY ART · طلب ${esc(o.id)}</h3>
        <div><b>العميل:</b> ${esc(o.name)}</div><div><b>الموبايل:</b> ${esc(o.phone)}${o.phone_extra ? ' / ' + esc(o.phone_extra) : ''}</div>
        <div><b>المحافظة:</b> ${esc(o.city)}</div><div><b>العنوان:</b> ${esc(o.address)}</div>${locationLink(o.location) ? `<div><b>الموقع:</b> ${locationLink(o.location)}</div>` : ''}
        <table><tr><th>المنتج</th><th>الكمية</th><th>السعر</th></tr>${o.items.map((i) => `<tr><td>${esc(i.name)}${i.option ? ' (' + esc(i.option) + ')' : ''}</td><td>${i.qty}</td><td>${money(i.line)}</td></tr>`).join('')}
        <tr><td>التوصيل</td><td></td><td>${money(o.delivery)}</td></tr><tr><th>الإجمالي</th><th></th><th>${money(o.total)}</th></tr></table>
        <div style="margin-top:8px"><b>الدفع:</b> ${esc(payLabel(o.payment))}${o.payment_status === 'Paid in full' ? ' · مدفوع بالكامل' : isCOD(o) ? ` · يُحصّل عند الاستلام: <b>${money(o.total)}</b>` : ''}</div>
        ${o.courier ? `<div><b>شركة الشحن:</b> ${esc(o.courier)}</div>` : ''}${o.notes ? `<div><b>ملاحظات:</b> ${esc(o.notes)}</div>` : ''}<div style="margin-top:6px;font-size:12px">تاريخ الطلب: ${fmtDate(o.date)}</div></div>`).join('');
      setTimeout(() => window.print(), 50);
    }

    /* ---------- views ---------- */
    document.querySelectorAll('.views [data-view]').forEach((b) => b.addEventListener('click', () => {
      view = b.dataset.view;
      document.querySelectorAll('.views [data-view]').forEach((x) => x.setAttribute('aria-pressed', x === b ? 'true' : 'false'));
