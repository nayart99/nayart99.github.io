          <label class="full">Short description (English)<textarea class="in" id="fBlurbEn" dir="ltr" rows="2">${esc(d.blurb.en || '')}</textarea></label>
          <label class="full">تفاصيل اللوحة بالعربي<textarea class="in" id="fAboutAr" rows="3">${esc(d.about.ar || '')}</textarea></label>
          <label class="full">Details (English)<textarea class="in" id="fAboutEn" dir="ltr" rows="3">${esc(d.about.en || '')}</textarea></label>
          <label>المستوى<select class="in" id="fLevel">${opt(LEVELS, d.level)}</select></label>
          <label>الشارة على الصورة<select class="in" id="fBadge">${opt(BADGES, d.badge)}</select></label>
          <label>اتجاه اللوحة<select class="in" id="fOr"><option value="portrait" ${d.orientation !== 'landscape' ? 'selected' : ''}>طولي</option><option value="landscape" ${d.orientation === 'landscape' ? 'selected' : ''}>عرضي</option></select></label>
          <label>الترتيب في الموقع<input class="in num" id="fOrder" type="number" min="1" value="${esc(d.order || 1)}"></label>
          <label class="sw full"><input type="checkbox" id="fSold" ${d.sold_out ? 'checked' : ''}><i></i>سولد أوت</label>
          <label class="sw full"><input type="checkbox" id="fActive" ${d.active !== false ? 'checked' : ''}><i></i>ظاهرة في الموقع</label>
        </div>
        <h3 class="pg-h3">الصور</h3>
        <div class="pg-imgs">${KEYS.map(([k, , label]) => `<div class="pg-slot" data-k="${k}"><div class="pg-thumb" id="th_${k}">${d.images[k] ? `<img src="${esc(src(d.images[k]))}" alt="">` : '<span>مفيش صورة</span>'}</div><b>${label}</b><label class="btn sm">${d.images[k] ? 'تغيير' : 'رفع صورة'}<input type="file" accept="image/*" hidden data-file="${k}"></label></div>`).join('')}</div>
        <p class="dnote">الصور بتتصغّر وتتحوّل لـ WebP تلقائيًا. «المرقّمة» و«بعد التلوين» لازم يبقوا نفس الكادر بالظبط علشان مقارنة قبل/بعد تشتغل صح.</p>
        <p class="pg-err" id="fErr" hidden></p>
        <div class="acts"><button class="btn p" id="fSave">${isNew ? 'إضافة اللوحة للموقع' : 'حفظ التعديلات'}</button><button class="btn" id="fCancel">إلغاء</button></div>`;
      $('pgBody').querySelectorAll('[data-file]').forEach((inp) => inp.onchange = async () => {
        const f = inp.files[0]; if (!f) return; const k = inp.dataset.file;
        try { const im = await readImg(f); imgs[k] = { ...encode(im), im }; $('th_' + k).innerHTML = `<img src="${imgs[k].data}" alt="">`; inp.parentElement.firstChild.textContent = 'تغيير'; }
        catch (e) { N().toast('الصورة مش مقروءة'); }
      });
      $('fCancel').onclick = close;
      $('fSave').onclick = async () => {
        const err = (m) => { $('fErr').textContent = m; $('fErr').hidden = false; };
        const v = (id) => $(id).value.trim();
        if (!v('fNameAr')) return err('اكتب اسم اللوحة بالعربي.');
        if (!(+v('fPrice') > 0)) return err('اكتب السعر.');
        if (!(d.images.finished || imgs.finished) || !(d.images.numbered || imgs.numbered)) return err('لازم صورة «بعد التلوين» وصورة «المرقّمة».');
        let slug = d.slug;
        if (isNew) { slug = slugify(v('fNameEn')) || 'painting-' + Date.now().toString(36); if (slug.length < 3) slug = 'painting-' + slug; while (products.some((x) => x.slug === slug)) slug += '-2'; }
        const [lAr, lEn] = $('fLevel').value.split('|'), [bAr, bEn] = $('fBadge').value.split('|');
        const out = { ...d, slug, name: { ar: v('fNameAr'), en: v('fNameEn') || v('fNameAr') }, blurb: { ar: v('fBlurbAr'), en: v('fBlurbEn') || v('fBlurbAr') }, about: { ar: v('fAboutAr'), en: v('fAboutEn') || v('fAboutAr') },
          level: { ar: lAr, en: lEn }, badge: { ar: bAr, en: bEn }, orientation: $('fOr').value, order: +v('fOrder') || 1,
          price: Math.round(+v('fPrice')), compare_price: Math.round(+v('fCompare') || 0), sold_out: $('fSold').checked, active: $('fActive').checked, images: { ...d.images } };
        const folder = d.images.finished ? d.images.finished.replace(/\/[^/]+$/, '') : '/media/products/' + slug;
        const stamp = Date.now().toString(36), upload = [];
        KEYS.forEach(([k, short]) => { if (!imgs[k]) return; const path = `${folder}/${short}-${stamp}.${imgs[k].ext}`; out.images[k] = path; pending[path] = imgs[k].data; upload.push({ path: 'public' + path, data: imgs[k].data }); });
        if (imgs.finished || imgs.numbered) delete out.images.timelapse_map; // the site rebuilds the painting animation from the new images
        if (imgs.finished || isNew) { try { out.palette = palette(imgs.finished ? imgs.finished.im : await readImgURL(src(out.images.finished))); } catch (e) {} }
        const b = $('fSave'); b.disabled = true; b.textContent = 'جارٍ الحفظ…'; $('fErr').hidden = true;
        try { await save([out], upload, (isNew ? 'New painting: ' : 'Edit painting: ') + (out.name.en || slug)); close(); N().toast(isNew ? 'اللوحة اتضافت — هتظهر على الموقع خلال دقيقتين' : 'اتحفظ — هيظهر على الموقع خلال دقيقتين'); }
        catch (e) { b.disabled = false; b.textContent = isNew ? 'إضافة اللوحة للموقع' : 'حفظ التعديلات'; err('تعذّر الحفظ: ' + ({ github_not_configured: 'مفتاح GitHub مش متضاف', bad_slug: 'اكتب الاسم الإنجليزي بحروف إنجليزي', images_required: 'الصور ناقصة' }[e.message] || e.message)); }
      };
      $('pgModal').hidden = false; document.body.style.overflow = 'hidden';
    }
    const readImgURL = (u) => new Promise((ok, no) => { const i = new Image(); i.crossOrigin = 'anonymous'; i.onload = () => ok(i); i.onerror = no; i.src = u; });
    function close() { $('pgModal').hidden = true; document.body.style.overflow = ''; }
    $('pgClose').onclick = close;
    $('pgModal').addEventListener('click', (e) => { if (e.target === $('pgModal')) close(); });
    $('pgNew').onclick = () => { if (!products) return N().toast('استنى تحميل المنتجات'); form(null); };
    $('pgBulk').onclick = () => {
      if (!products) return N().toast('استنى تحميل المنتجات');
      $('pgTitle').textContent = 'تغيير أسعار كل اللوحات الجاهزة';
      $('pgBody').innerHTML = `<p class="dnote">السعر الجديد هيتطبق على كل اللوحات (${products.length}). اللوحات المخفية كمان بتتغيّر علشان لو رجعت.</p>
        <div class="pg-grid"><label>السعر الجديد (ج.م) *<input class="in num" id="bPrice" type="number" min="1" value="${products[0] ? products[0].price : ''}"></label><label>السعر قبل الخصم (اختياري)<input class="in num" id="bCmp" type="number" min="0" value="${products[0] ? products[0].compare_price || '' : ''}"></label></div>
        <div class="acts" style="margin-top:14px"><button class="btn p" id="bSave">تطبيق على كل اللوحات</button><button class="btn" id="bCancel">إلغاء</button></div>`;
      $('bCancel').onclick = close;
      $('bSave').onclick = async () => {
        const price = Math.round(+$('bPrice').value), cmp = Math.round(+$('bCmp').value || 0);
        if (!(price > 0)) return N().toast('اكتب السعر');
        const b = $('bSave'); b.disabled = true; b.textContent = 'جارٍ الحفظ…';
        try { await save(products.map((p) => ({ ...p, price, compare_price: cmp })), [], `All paintings: price ${price}`); close(); N().toast('اتغيّرت الأسعار — هتظهر على الموقع خلال دقايق'); }
        catch (e) { b.disabled = false; b.textContent = 'تطبيق على كل اللوحات'; N().toast('تعذّر الحفظ: ' + e.message); }
      };
      $('pgModal').hidden = false; document.body.style.overflow = 'hidden';
    };

    // ---------- website settings ----------
    let site = null, siteCommit = '';
    async function openSite(force) {
      if (site && !force) return drawSite();
      $('stBody').innerHTML = '<p class="dnote">جارٍ التحميل…</p>';
      try { const j = await N().api('site_get'); site = j.settings; drawSite(); runStatus($('stStatus'), j.status); }
      catch (e) { $('stBody').innerHTML = e.message === 'github_not_configured' ? `<div class="flagbox warn"><b>لازم خطوة واحدة قبل ما تقدر تعدّل إعدادات الموقع</b><span>إضافة مفتاح GitHub (GITHUB_TOKEN) في إعدادات Apps Script.</span></div>` : `<div class="flagbox bad"><b>تعذّر التحميل</b><span>${esc(e.message)}</span></div>`; }
    }
    function runStatus(el, run, commit) {
      if (!run) { el.textContent = ''; return true; }
      const mine = !commit || !run.sha || run.sha === commit || run.sha === 'demo';
      if (run.status !== 'completed' || !mine) { el.className = 'pg-status busy'; el.innerHTML = '<span class="spin"></span>بيتنشر على الموقع… دقايق'; return false; }
      if (run.conclusion === 'success') { el.className = 'pg-status ok'; el.textContent = '✓ الموقع محدّث'; return true; }
      el.className = 'pg-status bad'; el.textContent = '⚠️ النشر فشل — كلّم Claude'; return true;
    }
    const sw = (id, on, label) => `<label class="sw"><input type="checkbox" id="${id}" ${on ? 'checked' : ''}><i></i>${label}</label>`;
    const fld = (id, label, val, extra = '') => `<label>${label}<input class="in" id="${id}" value="${esc(val == null ? '' : val)}" ${extra}></label>`;
    function drawSite() {
      const s = site, P = s.payments || {}, A = s.analytics || {}, So = s.social || {}, D = CFG.i18nDefaults;
      const local = (v) => String(v || '').replace(/^2(?=01)/, '');
      $('stBody').innerHTML = `
        <div class="st-grid">
          <div class="st-card ${s.orders_paused ? 'warn' : ''}"><h3>استقبال الطلبات</h3>
            ${sw('sOpen', !s.orders_paused, 'الموقع بيستقبل طلبات')}
            <p class="dnote">لو قفلته، العملاء يقدروا يتفرجوا بس مش هيقدروا يكملوا الطلب، وهتظهرلهم الرسالة دي فوق الموقع:</p>
            <div class="pg-grid">${fld('sPauseAr', 'رسالة الإيقاف (عربي)', (s.pause_message || {}).ar, 'placeholder="لا نستقبل طلبات جديدة حاليًا…"')}${fld('sPauseEn', 'Pause message (English)', (s.pause_message || {}).en, 'dir="ltr"')}</div>
          </div>
          <div class="st-card"><h3>الشريط اللي فوق في الموقع</h3>
            ${sw('sOffer', s.launch_offer, 'إظهار سطر العرض')}
            <div class="pg-grid">${fld('sAnn1Ar', 'سطر العرض (عربي)', (s.announce_text || {}).ar, `placeholder="${esc(D.announce_offer)}"`)}${fld('sAnn1En', 'Offer line (English)', (s.announce_text || {}).en, `dir="ltr" placeholder="${esc(D.announce_offer_en)}"`)}
            ${fld('sAnn2Ar', 'السطر التاني (عربي)', (s.announce_text2 || {}).ar, `placeholder="${esc(D.announce_cod)}"`)}${fld('sAnn2En', 'Second line (English)', (s.announce_text2 || {}).en, `dir="ltr" placeholder="${esc(D.announce_cod_en)}"`)}</div>
            <p class="dnote">سيبه فاضي علشان يفضل النص الحالي.</p>
          </div>
          <div class="st-card"><h3>التوصيل</h3>
            <div class="pg-grid">${fld('sFee', 'مصاريف التوصيل (ج.م)', s.delivery_fee, 'type="number" min="0" class="in num"')}${fld('sFree', 'توصيل مجاني لو الطلب فوق (ج.م)', s.free_delivery_over || 0, 'type="number" min="0" class="in num"')}</div>
            <p class="dnote">0 = مفيش توصيل مجاني. لو حطيت مثلًا 1500، أي طلب بـ 1500 أو أكتر توصيله مجاني، والسلة بتقول للعميل باقي كام.</p>
          </div>
          <div class="st-card"><h3>لوحة من صورة العميل — المقاسات والأسعار</h3>
            <div id="sSizes">${(s.custom_sizes || []).map((z, k) => sizeRow(z, k)).join('')}</div>
            <button class="btn sm" id="sAddSize">+ مقاس جديد</button>
          </div>
          <div class="st-card"><h3>طرق الدفع</h3>
            ${sw('sCod', P.cod, 'الدفع عند الاستلام (للوحات الجاهزة بس)')}${sw('sInsta', P.instapay, 'InstaPay')}${sw('sVoda', P.vodafone_cash, 'فودافون كاش')}
            <div class="pg-grid" style="margin-top:8px">${fld('sInstaN', 'رقم InstaPay', s.instapay, 'inputmode="tel" class="in num"')}${fld('sVodaN', 'رقم فودافون كاش', s.vodafone_cash, 'inputmode="tel" class="in num"')}</div>
          </div>
          <div class="st-card"><h3>التواصل</h3>
            <div class="pg-grid">${fld('sPhone', 'رقم الدعم (اتصال)', s.phone_display, 'inputmode="tel" class="in num"')}${fld('sWa', 'رقم الواتساب', local(s.whatsapp_intl), 'inputmode="tel" class="in num"')}
            ${fld('sEmail', 'الإيميل', s.email, 'dir="ltr" inputmode="email"')}${fld('sIg', 'Instagram', So.instagram, 'dir="ltr"')}${fld('sFb', 'Facebook', So.facebook, 'dir="ltr"')}${fld('sTt', 'TikTok', So.tiktok, 'dir="ltr"')}</div>
          </div>
          <div class="st-card"><h3>التتبع والإعلانات (متقدم)</h3>
            <div class="pg-grid">${fld('sPixel', 'Meta Pixel ID', A.meta_pixel_id, 'dir="ltr" class="in num"')}${fld('sGa', 'Google Analytics (GA4) ID', A.ga4_id, 'dir="ltr" placeholder="G-XXXXXXX"')}</div>
          </div>
        </div>
        <p class="pg-err" id="sErr" hidden></p>
        <div class="st-save"><button class="btn p" id="sSave">حفظ ونشر على الموقع</button><span class="dnote">بيظهر على الموقع خلال دقايق.</span></div>`;
      const bindSizes = () => $('sSizes').querySelectorAll('[data-rm]').forEach((b) => b.onclick = () => { if ($('sSizes').children.length <= 1) return N().toast('لازم مقاس واحد على الأقل'); b.closest('.st-size').remove(); });
      bindSizes();
      $('sAddSize').onclick = () => { $('sSizes').insertAdjacentHTML('beforeend', sizeRow({ label: '', price: '' }, Date.now())); bindSizes(); };
      $('sSave').onclick = saveSite;
    }
    const sizeRow = (z, k) => { const m = String(z.label || '').match(/(\d+)\s*[×x]\s*(\d+)/) || []; return `<div class="st-size"><input class="in num" data-w value="${m[1] || ''}" placeholder="العرض" aria-label="العرض سم"><span>×</span><input class="in num" data-h value="${m[2] || ''}" placeholder="الطول" aria-label="الطول سم"><span>سم</span><input class="in num" data-p type="number" min="1" value="${esc(z.price)}" placeholder="السعر" aria-label="السعر"><span>ج.م</span><button class="btn sm ed-del" data-rm="${k}" aria-label="حذف المقاس">✕</button></div>`; };
    async function saveSite() {
      const v = (id) => $(id).value.trim(), err = (m) => { $('sErr').textContent = m; $('sErr').hidden = false; };
      const sizes = [...$('sSizes').querySelectorAll('.st-size')].map((r) => ({ w: r.querySelector('[data-w]').value.trim(), h: r.querySelector('[data-h]').value.trim(), p: r.querySelector('[data-p]').value.trim() }));
      if (sizes.some((z) => !(+z.w >= 10 && +z.h >= 10 && +z.p > 0))) return err('اكتب العرض والطول والسعر لكل مقاس.');
      if (!$('sCod').checked && !$('sInsta').checked && !$('sVoda').checked) return err('لازم طريقة دفع واحدة على الأقل.');
      const out = {
        orders_paused: !$('sOpen').checked, pause_message: { ar: v('sPauseAr'), en: v('sPauseEn') },
        launch_offer: $('sOffer').checked, announce_text: { ar: v('sAnn1Ar'), en: v('sAnn1En') }, announce_text2: { ar: v('sAnn2Ar'), en: v('sAnn2En') },
        delivery_fee: +v('sFee') || 0, free_delivery_over: +v('sFree') || 0,
        custom_sizes: sizes.map((z) => ({ label: `${+z.w}×${+z.h} cm`, price: Math.round(+z.p) })),
        payments: { cod: $('sCod').checked, instapay: $('sInsta').checked, vodafone_cash: $('sVoda').checked },
        instapay: v('sInstaN'), vodafone_cash: v('sVodaN'), support_phone: v('sPhone'), whatsapp: v('sWa'), email: v('sEmail'),
        social: { instagram: v('sIg'), facebook: v('sFb'), tiktok: v('sTt') }, analytics: { meta_pixel_id: v('sPixel'), ga4_id: v('sGa') },
      };
      if (out.orders_paused && !confirm('متأكد إنك عايز توقف استقبال الطلبات على الموقع؟')) return;
      const b = $('sSave'); b.disabled = true; b.textContent = 'جارٍ الحفظ…'; $('sErr').hidden = true;
      try {
        const j = await N().api('site_save', { settings: out });
        site = j.settings || site; siteCommit = j.commit || ''; drawSite(); runStatus($('stStatus'), { status: 'queued' }, siteCommit);
        N().toast('اتحفظ — هيظهر على الموقع خلال دقايق');
        const tick = async () => { try { const s = await N().api('catalog_status'); if (runStatus($('stStatus'), s.run, siteCommit)) return; } catch (e) {} setTimeout(tick, 10000); };
        setTimeout(tick, 8000);
      } catch (e) { b.disabled = false; b.textContent = 'حفظ ونشر على الموقع'; err('تعذّر الحفظ: ' + ({ bad_phone: 'في رقم موبايل مش صحيح (لازم 11 رقم يبدأ بـ 01)', bad_url: 'لينك السوشيال لازم يبدأ بـ https://', bad_email: 'الإيميل مش صحيح', bad_size: 'مقاس مش صحيح', no_payment: 'لازم طريقة دفع واحدة على الأقل', github_not_configured: 'مفتاح GitHub مش متضاف' }[e.message] || e.message)); }
    }

    window.NAY_PRODUCTS = { open: () => open(false), openSite: () => openSite(false) };
  })();
  </script>
</body>
</html>
