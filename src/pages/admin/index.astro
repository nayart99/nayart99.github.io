---
// Owner dashboard: orders, statuses, customer photos. Data comes from the Google Apps Script backend.
// Open with ?demo=1 to see it with sample orders.
import { settings, getProducts, pick, STRINGS } from '../../lib/site.js';
const allProducts = Object.values(import.meta.glob('../../content/products/*.json', { eager: true })).map((m) => m.default || m);
const cfg = { allProducts, site: settings, i18nDefaults: { announce_offer: STRINGS.ar.announce_offer, announce_cod: STRINGS.ar.announce_cod, announce_offer_en: STRINGS.en.announce_offer, announce_cod_en: STRINGS.en.announce_cod }, endpoint: settings.orders_endpoint || '', whatsapp: settings.whatsapp_intl, brand: settings.brand, payNumber: settings.instapay || settings.vodafone_cash || '',
  catalog: getProducts().map((p) => ({ slug: p.slug, name: pick(p.name, 'ar'), price: p.price, option: String(settings.canvas_size || '40×50 cm').replace('cm', 'سم') })),
  customSizes: settings.custom_sizes || [], govs: (STRINGS.ar && STRINGS.ar.gov) || [] };
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <title>لوحة الطلبات | NAY ART</title>
  <meta name="theme-color" content="#7A1F2B" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600&family=Cormorant+Garamond:wght@500;600&display=swap" />
  <style is:inline>
    :root{--cream:#F7F3EC;--paper:#FFFDF9;--sand:#EDE4D8;--ink:#3A1E22;--soft:#6E5A57;--line:#DCCFC0;--wine:#7A1F2B;--wine-d:#5C1620;--blush:#E2B8A8;
      --s-new:#7A1F2B;--s-conf:#2F5D8A;--s-wait:#9A6A12;--s-prep:#6B4FA0;--s-ship:#1F6F78;--s-done:#2E7D4F;--s-cancel:#8C8580;color-scheme:light}
    *{box-sizing:border-box}
    body{margin:0;background:var(--cream);color:var(--ink);font-family:"IBM Plex Sans Arabic","Segoe UI",Tahoma,sans-serif;font-size:15px;line-height:1.6;-webkit-font-smoothing:antialiased}
    button,input,select,textarea{font:inherit;color:inherit}
    button{cursor:pointer}
    [hidden]{display:none!important}
    .wrap{max-width:1180px;margin:0 auto;padding:0 16px}
    .num{font-variant-numeric:tabular-nums;direction:ltr;unicode-bidi:isolate}
    /* login */
    .login{min-height:100vh;display:grid;place-items:center;padding:24px}
    .login form{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:32px 28px;width:min(380px,100%);display:flex;flex-direction:column;gap:14px;box-shadow:0 20px 50px -30px rgba(58,30,34,.4)}
    .login img{width:150px;margin:0 auto 4px}
    .login h1{margin:0;text-align:center;font-size:1.25rem;font-weight:600}
    .login p{margin:0;text-align:center;color:var(--soft);font-size:.9rem}
    .in{width:100%;border:1px solid var(--line);background:#fff;border-radius:10px;padding:11px 14px}
    .in:focus{outline:2px solid var(--wine);outline-offset:1px;border-color:transparent}
    .btn{border:1px solid var(--line);background:var(--paper);border-radius:10px;padding:10px 16px;font-weight:500;display:inline-flex;align-items:center;justify-content:center;gap:8px;text-decoration:none;color:var(--ink);white-space:nowrap}
    .btn:hover{border-color:var(--ink)}
    .btn.p{background:var(--wine);border-color:var(--wine);color:#fff}
    .btn.p:hover{background:var(--wine-d)}
    .btn.wa{background:#1f7a4d;border-color:#1f7a4d;color:#fff}
    .btn svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
    .err{color:var(--wine);font-size:.88rem;text-align:center;min-height:1.2em}
    .chk{display:flex;gap:8px;align-items:center;font-size:.9rem;color:var(--soft)}
    /* top bar */
    header{background:var(--paper);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20}
    header .wrap{display:flex;align-items:center;gap:12px;height:64px}
    header img{height:26px}
    header h1{font-size:1.05rem;margin:0;font-weight:600;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .live{font-size:.8rem;color:var(--soft);display:flex;align-items:center;gap:6px}
    .live i{width:8px;height:8px;border-radius:50%;background:#2E7D4F;display:inline-block;box-shadow:0 0 0 3px rgba(46,125,79,.18)}
    .icon-btn{border:1px solid var(--line);background:var(--paper);border-radius:10px;width:40px;height:40px;display:grid;place-items:center}
    .icon-btn svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8}
    .spin svg{animation:sp 1s linear infinite}@keyframes sp{to{transform:rotate(-360deg)}}
    .demo{background:#FFF4D6;border-bottom:1px solid #EBD9A6;color:#6B5310;font-size:.88rem;text-align:center;padding:8px 16px}
    main{padding:22px 0 60px}
    /* KPIs */
    .kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:22px}
    .kpi{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:16px}
    .kpi span{display:block;color:var(--soft);font-size:.85rem}
    .kpi b{display:block;font-size:1.7rem;font-weight:600;line-height:1.3;margin-top:4px}
    .kpi small{color:var(--soft);font-size:.8rem}
    .kpi.hot{border-color:var(--wine);background:linear-gradient(180deg,#fff,#FBF1EF)}
    .kpi.hot b{color:var(--wine)}
    /* tabs + search */
    .tools{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-bottom:14px}
    .tabs{display:flex;gap:6px;overflow-x:auto;padding-bottom:4px;scrollbar-width:none;max-width:100%}
    .tabs::-webkit-scrollbar{display:none}
    .tab{border:1px solid var(--line);background:var(--paper);border-radius:999px;padding:7px 14px;font-size:.88rem;white-space:nowrap;display:flex;gap:6px;align-items:center}
    .tab[aria-pressed=true]{background:var(--ink);color:#fff;border-color:var(--ink)}
    .tab em{font-style:normal;font-size:.78rem;background:rgba(0,0,0,.07);border-radius:999px;padding:0 7px}
    .tab[aria-pressed=true] em{background:rgba(255,255,255,.2)}
    .search{position:relative;flex:0 1 300px}
    .search .in{padding-inline-start:38px}
    .search svg{position:absolute;inset-inline-start:12px;top:50%;transform:translateY(-50%);width:17px;height:17px;fill:none;stroke:var(--soft);stroke-width:1.8}
    /* orders */
    .list{display:flex;flex-direction:column;gap:10px}
    .ord{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:14px 16px;display:grid;grid-template-columns:56px 1fr auto;gap:14px;align-items:center;cursor:pointer;text-align:start;width:100%;transition:border-color .15s,box-shadow .15s}
    .ord:hover{border-color:var(--ink);box-shadow:0 8px 24px -18px rgba(58,30,34,.5)}
    .ord.fresh{border-color:var(--wine);box-shadow:0 0 0 3px rgba(122,31,43,.12)}
    .th{width:56px;height:56px;border-radius:8px;background:var(--sand);display:grid;place-items:center;overflow:hidden}
    .th img{width:100%;height:100%;object-fit:cover}
    .th svg{width:24px;height:24px;fill:none;stroke:var(--soft);stroke-width:1.5}
    .o-main{min-width:0}
    .o-top{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
    .o-id{font-weight:600}
    .o-time{color:var(--soft);font-size:.82rem}
    .o-who{margin-top:2px}
    .o-items{color:var(--soft);font-size:.88rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .o-end{text-align:end;display:flex;flex-direction:column;gap:6px;align-items:flex-end}
    .o-total{font-weight:600;font-size:1.05rem}
    .pill{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:2px 10px;font-size:.8rem;font-weight:500;color:var(--c);background:color-mix(in srgb,var(--c) 11%,#fff);border:1px solid color-mix(in srgb,var(--c) 28%,#fff);white-space:nowrap}
    .pill::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--c)}
    .tag{font-size:.75rem;border:1px solid var(--line);border-radius:999px;padding:1px 8px;color:var(--soft)}
    .tag.unpaid{color:#8A5A00;background:#FFF4D6;border-color:#EBD9A6;font-weight:600}
    .tag.dsg{color:#1E5B36;background:#EAF6EE;border-color:#B9DEC6;font-weight:600}
    .tag.dsg-w{color:#6B5310;background:#FFF4D6;border-color:#EBD9A6}
    .dnote{margin:0 0 8px;font-size:.86rem;color:var(--soft)}
    .dmeta{font-size:.86rem;color:var(--soft);margin-bottom:8px}
    .dj+.dj{margin-top:14px;padding-top:14px;border-top:1px dashed var(--line)}
    .dprev{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .dprev figure{margin:0}.dprev .im{aspect-ratio:4/5;background:#fff;border:1px solid var(--line);border-radius:8px;display:grid;place-items:center;overflow:hidden;cursor:zoom-in;font-size:.8rem;color:var(--soft)}
    .dprev .im img{width:100%;height:100%;object-fit:contain}
    .dprev figcaption{font-size:.8rem;color:var(--soft);text-align:center;margin-top:4px}
    .palette{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0}
    .palette span{display:inline-flex;align-items:center;gap:4px;font-size:.78rem;border:1px solid var(--line);border-radius:999px;padding:2px 8px 2px 3px;background:#fff;direction:ltr}
    .palette i{width:14px;height:14px;border-radius:50%;border:1px solid rgba(0,0,0,.12);display:inline-block}
    .dwait{display:flex;gap:10px;align-items:center;margin:0;font-size:.9rem}
    .spin{width:16px;height:16px;border:2px solid var(--line);border-top-color:var(--wine);border-radius:50%;animation:spin 1s linear infinite;flex:none}
    @keyframes spin{to{transform:rotate(360deg)}}
    .regen{margin-top:12px;font-size:.88rem}.regen summary{cursor:pointer;color:var(--soft)}.regen .acts{margin-top:8px}
    .in.sm{width:auto;padding:8px 10px;min-height:0}
    .dapprove{margin-top:14px;padding-top:12px;border-top:1px solid var(--line)}
    .pg-sum{display:flex;flex-wrap:wrap;gap:8px;margin:-4px 0 14px}.pg-sum span{background:var(--paper);border:1px solid var(--line);border-radius:999px;padding:4px 12px;font-size:.85rem}.pg-sum .ok{border-color:#B9DEC6}.pg-sum .so{border-color:#E9B9C1}.pg-sum .hd{border-color:#d8cfc4}
    button.pg-price{all:unset;cursor:pointer;font-weight:600;display:inline-flex;gap:6px;align-items:baseline}button.pg-price i{font-style:normal;color:var(--soft);font-size:.8rem}button.pg-price:hover i{color:var(--wine)}
    .pg-qp{display:flex;flex-wrap:wrap;gap:6px;align-items:flex-end;margin-top:4px}.pg-qp label{display:flex;flex-direction:column;font-size:.75rem;color:var(--soft);gap:2px}.pg-qp .in{width:96px;padding:6px 8px;color:var(--ink)}
    .st-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(360px,1fr));gap:14px}
    .st-card{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:16px;display:flex;flex-direction:column;gap:10px}.st-card h3{margin:0;font-size:1rem}
    .st-card.warn{border-color:#C62828;box-shadow:0 0 0 3px rgba(198,40,40,.1)}
    .st-card .dnote{margin:0}
    .st-size{display:flex;align-items:center;gap:5px;margin-bottom:8px}.st-size .in{width:56px;padding:7px 6px;text-align:center}.st-size [data-p]{width:82px}.st-size .ed-del{margin-inline-start:auto}.st-size span{font-size:.85rem;color:var(--soft)}
    .st-save{position:sticky;bottom:0;background:linear-gradient(transparent,var(--cream) 30%);padding:18px 0 14px;display:flex;align-items:center;gap:12px;margin-top:8px}
    @media (max-width:420px){.st-grid{grid-template-columns:1fr}}
    .pg-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin-bottom:16px}
    .pg-head h2{margin:0;font-size:1.3rem}.pg-head .sub{margin:4px 0 0;color:var(--soft);font-size:.88rem}
    .pg-tools{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
    .pg-status{font-size:.85rem;display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border-radius:999px;border:1px solid var(--line)}
    .pg-status.ok{color:#1E5B36;background:#EAF6EE;border-color:#B9DEC6}.pg-status.busy{color:#6B5310;background:#FFF4D6;border-color:#EBD9A6}.pg-status.bad{color:#8E1B1B;background:#FDECEC;border-color:#F3B5B5}
    .pg-status:empty{display:none}
    .pg-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:14px}
    .pg-card{background:var(--paper);border:1px solid var(--line);border-radius:14px;overflow:hidden;display:flex;flex-direction:column}
    .pg-img{position:relative;aspect-ratio:4/3;background:var(--sand)}.pg-img img{width:100%;height:100%;object-fit:cover}
    .pg-card.is-sold .pg-img img,.pg-card.is-hidden .pg-img img{filter:grayscale(.7) opacity(.75)}
    .pg-flag{position:absolute;top:10px;inset-inline-start:10px;background:var(--ink);color:#fff;font-size:.78rem;padding:3px 10px;border-radius:999px}
    .pg-info{padding:12px 14px 4px;display:flex;flex-direction:column;gap:2px}.pg-en{font-size:.8rem;color:var(--soft);direction:ltr;text-align:right}
    .pg-price{font-weight:600}.pg-price s{color:var(--soft);font-weight:400;font-size:.85rem}
    .pg-acts{padding:8px 14px 14px;display:flex;flex-direction:column;gap:8px;margin-top:auto}.pg-acts .row{display:flex;gap:8px}.pg-acts .row .btn{flex:1}
    .sw{display:flex;align-items:center;gap:10px;font-size:.88rem;cursor:pointer;user-select:none}
    .sw input{position:absolute;opacity:0;width:1px;height:1px}
    .sw i{width:38px;height:22px;border-radius:999px;background:#d8cfc4;position:relative;flex:none;transition:background .2s}
    .sw i::after{content:"";position:absolute;top:3px;inset-inline-start:3px;width:16px;height:16px;border-radius:50%;background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.2);transition:transform .2s}
    .sw input:checked+i{background:var(--wine)}.sw input:checked+i::after{transform:translateX(-16px)}
    [dir=ltr] .sw input:checked+i::after{transform:translateX(16px)}
    .sw input:focus-visible+i{outline:2px solid var(--wine);outline-offset:2px}
    .pg-modal{position:fixed;inset:0;background:rgba(40,20,22,.45);z-index:60;display:flex;align-items:flex-start;justify-content:center;overflow:auto;padding:24px 12px}
    .pg-dialog{background:var(--cream);border-radius:16px;width:min(760px,100%);box-shadow:0 20px 60px rgba(0,0,0,.25)}
    .pg-dhead{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;border-bottom:1px solid var(--line)}.pg-dhead h2{margin:0;font-size:1.1rem}
    .pg-body{padding:16px 18px 20px}
    .pg-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.pg-grid label{display:flex;flex-direction:column;gap:4px;font-size:.82rem;color:var(--soft)}.pg-grid .full{grid-column:1/-1}.pg-grid .in{color:var(--ink);padding:9px 12px}
    .pg-grid .sw{flex-direction:row;color:var(--ink)}
    .pg-h3{margin:16px 0 8px;font-size:.9rem}
    .pg-imgs{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:10px}
    .pg-slot{display:flex;flex-direction:column;gap:6px;align-items:stretch;font-size:.78rem;text-align:center}
    .pg-thumb{aspect-ratio:1;border:1px dashed var(--line);border-radius:10px;background:#fff;display:grid;place-items:center;overflow:hidden;color:var(--soft)}.pg-thumb img{width:100%;height:100%;object-fit:cover}
    .pg-err{color:#a32626;font-size:.88rem;margin:10px 0 0}
    @media (max-width:560px){.pg-grid{grid-template-columns:1fr}}
    .h3row{display:flex;justify-content:space-between;align-items:center;gap:8px}
    .btn.sm{padding:5px 10px;font-size:.8rem;border-radius:8px}
    .ed-items{display:flex;flex-direction:column;gap:10px;margin-bottom:10px}
    .ed-row{display:grid;grid-template-columns:1fr auto;gap:8px;align-items:center;padding:10px;border:1px solid var(--line);border-radius:10px;background:#fff}
    .ed-name{grid-column:1/-1;display:grid;grid-template-columns:2fr 1fr;gap:6px}
    .ed-row .in{padding:7px 10px}
    .ed-q{display:flex;align-items:center;gap:4px}.ed-q .in{width:58px;text-align:center}
    .ed-p{display:flex;align-items:center;gap:6px;font-size:.82rem;color:var(--soft)}.ed-p .in{width:96px}
    .ed-line{font-weight:600}
    .ed-del{color:#a32626;border-color:#e8c2c2;justify-self:end}
    .ed-pay{display:flex;flex-wrap:wrap;gap:6px}.ed-pay .btn.on{background:var(--wine);color:#fff;border-color:var(--wine)}.ed-tot{margin-top:10px}.ed-tot>label{display:flex;align-items:center;gap:8px;font-size:.88rem;margin-bottom:6px}.ed-tot>label .in{width:120px;padding:7px 10px}
    .ed-diff{margin:8px 0 0;font-size:.86rem;background:#FFF4E0;border:1px solid #F1D39A;border-radius:8px;padding:8px 10px}
    .ed-cust{display:grid;grid-template-columns:1fr 1fr;gap:8px}.ed-cust label{display:flex;flex-direction:column;gap:3px;font-size:.8rem;color:var(--soft)}.ed-cust .full{grid-column:1/-1}.ed-cust .in{padding:8px 10px;color:var(--ink)}
    @media (max-width:520px){.ed-row{grid-template-columns:1fr}.ed-name{grid-template-columns:1fr}.ed-cust{grid-template-columns:1fr}}
    .tag.flag{color:#fff;background:#C62828;border-color:#C62828;font-weight:700}
    .sec.flag{border-color:#C62828;box-shadow:0 0 0 3px rgba(198,40,40,.12)}
    .flagbox{display:flex;flex-direction:column;gap:3px;padding:10px 12px;border-radius:8px;margin-bottom:10px;font-size:.88rem}
    .flagbox.bad{background:#FDECEC;color:#8E1B1B;border:1px solid #F3B5B5}
    .flagbox.warn{background:#FFF4E0;color:#7A4B00;border:1px solid #F1D39A}
    .flagbox.ok{background:#EAF6EE;color:#1E5B36;border:1px solid #B9DEC6}
    .msgprev{margin-top:8px;font-size:.85rem}.msgprev summary{cursor:pointer;color:var(--soft)}
    .msgprev pre{white-space:pre-wrap;font-family:inherit;background:var(--bg,#faf7f2);border:1px solid var(--line);border-radius:8px;padding:10px;margin:6px 0 0}
    .tag.review{color:#7A1F2B;background:#FBE9EC;border-color:#E9B9C1;font-weight:700}
    .sec.attn{border-color:var(--wine);box-shadow:0 0 0 3px rgba(122,31,43,.08)}
    .btn.ok{background:#2E7D4F;border-color:#2E7D4F;color:#fff;font-weight:600}
    .proof{display:flex;flex-direction:column;gap:8px;align-items:flex-start}
    .proof img{max-width:100%;max-height:340px;border:1px solid var(--line);border-radius:8px;background:#fff}
    .pay-check{margin:10px 0 0;font-size:.88rem;color:var(--ink)}
    .dlab{display:flex;flex-direction:column;gap:4px;font-size:.82rem;color:var(--soft);flex:1}
    .tag.ship{color:#1F4E79;background:#EAF2FB;border-color:#BCD3EA;font-weight:600}
    .ship-row{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:12px;padding-top:10px;border-top:1px dashed var(--line)}.ship-l{font-size:.85rem;color:var(--soft);font-weight:600}
    .ship-c{display:flex;flex-wrap:wrap;gap:6px}.chip{border:1px solid var(--line);background:var(--paper);border-radius:999px;padding:6px 14px;font:inherit;font-size:.86rem;color:var(--ink);cursor:pointer}
    .chip.on{background:#1F4E79;border-color:#1F4E79;color:#fff;font-weight:600}.chip.add{border-style:dashed;color:var(--soft)}.chip.link{border:0;background:none;color:var(--soft);text-decoration:underline;padding:6px 4px}
    .cpick{position:fixed;inset:0;background:rgba(20,10,12,.55);z-index:80;display:grid;place-items:center;padding:16px}
    .cpick-box{background:var(--paper);border-radius:14px;padding:20px;width:min(420px,100%);box-shadow:0 20px 50px -20px rgba(0,0,0,.5)}.cpick-box h3{margin:0 0 14px;font-size:1.02rem}
    .cpick-list{display:grid;gap:8px}.cpick-list .btn{justify-content:flex-start;padding:13px 16px;font-size:1rem;font-weight:600}.cpick-list .btn:hover,.cpick-list .btn:focus{border-color:#1F4E79;background:#EAF2FB}
    .cpick-add{display:flex;gap:8px;margin-top:10px}.cpick-add .in{flex:1;padding:9px 12px}.cpick .acts{margin-top:12px}
    .tag.paid{color:#2E7D4F;background:#EAF5EE;border-color:#BFE0CB}
    .empty{text-align:center;padding:60px 20px;color:var(--soft);background:var(--paper);border:1px dashed var(--line);border-radius:12px}
    .empty b{display:block;color:var(--ink);font-size:1.1rem;margin-bottom:4px}
    /* monthly */
    .month{margin-top:28px;display:grid;grid-template-columns:1.3fr 1fr;gap:12px}
    .card{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:16px 18px}
    .card h2{font-size:1rem;margin:0 0 10px}
    table{width:100%;border-collapse:collapse;font-size:.9rem}
    th,td{text-align:start;padding:8px 6px;border-bottom:1px solid var(--line)}
    th{color:var(--soft);font-weight:500;font-size:.82rem}
    tr:last-child td{border-bottom:0}
    /* detail */
    .scrim{position:fixed;inset:0;background:rgba(40,20,22,.42);z-index:40;opacity:0;pointer-events:none;transition:opacity .2s}
    .scrim.on{opacity:1;pointer-events:auto}
    .panel{position:fixed;top:0;bottom:0;inset-inline-end:0;width:min(560px,100%);background:var(--cream);z-index:41;transform:translateX(-100%);transition:transform .25s ease,visibility .25s;display:flex;flex-direction:column;visibility:hidden}
    [dir=rtl] .panel{inset-inline-end:auto;left:0}
    .panel.on{transform:none;visibility:visible;box-shadow:0 0 40px rgba(0,0,0,.18)}
    .p-head{display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid var(--line);background:var(--paper)}
    .p-head h2{margin:0;font-size:1.1rem;flex:1}
    .p-body{overflow-y:auto;padding:18px;display:flex;flex-direction:column;gap:14px}
    .sec{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:14px 16px}
    .sec h3{margin:0 0 10px;font-size:.85rem;color:var(--soft);font-weight:500}
    .kv{display:grid;grid-template-columns:110px 1fr;gap:6px 10px;font-size:.93rem}
    .kv dt{color:var(--soft)}
    .kv dd{margin:0}
    .acts{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
    .line{display:flex;justify-content:space-between;gap:10px;padding:6px 0;border-bottom:1px dashed var(--line);font-size:.93rem}
    .line:last-child{border-bottom:0}
    .line.t{font-weight:600;font-size:1rem}
    .photos{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
    .ph{border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--sand)}
    .ph .im{aspect-ratio:1;display:grid;place-items:center;background:var(--sand)}
    .ph img{width:100%;height:100%;object-fit:contain;display:block}
    .ph .a{display:flex;gap:6px;padding:8px;flex-wrap:wrap}
    .ph .a .btn{padding:6px 10px;font-size:.8rem;flex:1}
    .row2{display:flex;gap:8px}
    .row2 select{flex:1}
    textarea.in{min-height:80px;resize:vertical}
    .saved{color:#2E7D4F;font-size:.85rem}
    .toast{position:fixed;bottom:20px;left:50%;transform:translate(-50%,20px);background:var(--ink);color:#fff;padding:10px 18px;border-radius:999px;font-size:.9rem;opacity:0;transition:.2s;z-index:60;pointer-events:none}
    .toast.on{opacity:1;transform:translate(-50%,0)}
    .lightbox{position:fixed;inset:0;background:rgba(20,10,12,.88);z-index:70;display:grid;place-items:center;padding:20px}
    .lightbox img{max-width:100%;max-height:86vh;border-radius:6px}
    .lightbox .x{position:absolute;top:16px;left:16px}
    /* views */
    .views{display:flex;gap:4px;background:var(--sand);padding:4px;border-radius:12px;width:max-content;margin-bottom:18px}
    .views button{border:0;background:transparent;padding:8px 18px;border-radius:9px;font-weight:500;color:var(--soft)}
    .views button[aria-pressed=true]{background:var(--paper);color:var(--ink);box-shadow:0 1px 3px rgba(58,30,34,.15)}
    @media (max-width:560px){.views{width:auto;max-width:100%;overflow-x:auto;scrollbar-width:none}.views::-webkit-scrollbar{display:none}.views button{padding:8px 12px;flex:none}}
    /* filters + bulk */
    .filters{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:12px}
    .filters select,.filters input[type=date]{border:1px solid var(--line);background:#fff;border-radius:9px;padding:8px 10px;font-size:.88rem;max-width:100%}
    .filters .grow{flex:1}
    .filters .btn{padding:8px 12px;font-size:.88rem}
    .selall{display:flex;align-items:center;gap:6px;font-size:.88rem;color:var(--soft)}
    .bulk{position:sticky;top:64px;z-index:15;display:flex;flex-wrap:wrap;gap:8px;align-items:center;background:var(--ink);color:#fff;padding:10px 14px;border-radius:12px;margin-bottom:12px}
    .bulk b{margin-inline-end:6px}
    .bulk select{border:0;border-radius:8px;padding:7px 10px;background:#fff;color:var(--ink)}
    .bulk .btn{padding:7px 12px;font-size:.85rem}
    .ord{grid-template-columns:24px 56px 1fr auto}
    .ord .pick{width:20px;height:20px;accent-color:var(--wine);cursor:pointer}
    .ord.sel{border-color:var(--wine);background:#FBF4F3}
    .count-line{font-size:.85rem;color:var(--soft);margin:0 0 10px}
    /* analytics */
    .seg{display:flex;flex-wrap:wrap;gap:6px}
    .seg button{border:1px solid var(--line);background:var(--paper);border-radius:999px;padding:7px 14px;font-size:.88rem}
    .seg button[aria-pressed=true]{background:var(--ink);color:#fff;border-color:var(--ink)}
    .a-head{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:16px}
    .a-head small{color:var(--soft)}
    .kpis.k8{grid-template-columns:repeat(4,1fr)}
    .delta{display:inline-block;margin-inline-start:6px;font-size:.78rem;color:var(--soft);font-weight:500}
    .vsec{margin:4px 0 26px}.vhead{display:flex;flex-wrap:wrap;align-items:baseline;gap:10px;margin-bottom:12px}.vhead h2,.ahead2{font-size:1.1rem;margin:0}.vhead small{color:var(--soft);font-size:.8rem}.ahead2{margin:0 0 12px}
    .vsec .agrid{margin-top:12px}.kpi.hi{border-color:var(--wine);background:#FBF3F0}
    .agrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .agrid .wide{grid-column:1/-1}
    .card .sub{font-size:.8rem;color:var(--soft);margin:-6px 0 10px}
    .cols{position:relative;display:flex;align-items:flex-end;gap:2px;height:190px;border-bottom:1px solid var(--line);padding-top:8px}
    .cols .c{flex:1;height:100%;display:flex;align-items:flex-end;cursor:default;position:relative;z-index:1}
    .cols .c i{display:block;width:100%;background:var(--wine);border-radius:4px 4px 0 0;min-height:0;transition:opacity .15s}
    .cols .c:hover i{opacity:.75}
    .cols .grid{position:absolute;inset:8px 0 0;pointer-events:none}
    .cols .grid span{position:absolute;left:0;right:0;border-top:1px dashed #EAE1D6;font-size:.7rem;color:var(--soft)}
    .cols .grid span em{position:absolute;inset-inline-start:0;top:-16px;font-style:normal;background:var(--paper);padding:0 4px}
    .xlab{display:flex;justify-content:space-between;font-size:.72rem;color:var(--soft);margin-top:6px}
    .bars{display:flex;flex-direction:column;gap:9px}
    .bar{display:grid;grid-template-columns:minmax(90px,38%) 1fr auto;gap:10px;align-items:center;font-size:.88rem}
    .bar .lab{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .bar .trk{height:10px;background:#F1EAE1;border-radius:99px;overflow:hidden}
    .bar .trk i{display:block;height:100%;background:var(--wine);border-radius:99px}
    .bar .val{color:var(--soft);font-size:.8rem;white-space:nowrap}
    .tip{position:fixed;z-index:80;background:var(--ink);color:#fff;font-size:.82rem;padding:6px 10px;border-radius:8px;pointer-events:none;white-space:nowrap;opacity:0;transition:opacity .1s}
    .tip.on{opacity:1}
    .none{color:var(--soft);font-size:.88rem;padding:10px 0}
    #printArea{display:none}
    @media print{
      body>*:not(#printArea){display:none!important}
      #printArea{display:block!important}
      .lbl{page-break-after:always;border:2px solid #000;padding:18px;font-size:14px;line-height:1.6;color:#000;font-family:"IBM Plex Sans Arabic",Tahoma,sans-serif}
      .lbl h3{margin:0 0 8px;font-size:18px}
      .lbl table{width:100%;border-collapse:collapse;margin-top:10px}
      .lbl td,.lbl th{border:1px solid #999;padding:4px 6px;font-size:13px}
    }
    @media (max-width:860px){.kpis{grid-template-columns:repeat(2,1fr)}.kpis.k8{grid-template-columns:repeat(2,1fr)}.month{grid-template-columns:1fr}.agrid{grid-template-columns:1fr}}
    @media (max-width:560px){
      header h1{font-size:.95rem}.live span{display:none}
      .ord{grid-template-columns:22px 48px 1fr;gap:10px}.th{width:48px;height:48px}
      .o-end{grid-column:1/-1;flex-direction:row;justify-content:space-between;align-items:center;border-top:1px dashed var(--line);padding-top:10px}
      .kpi b{font-size:1.4rem}.search{flex:1 1 100%}.kv{grid-template-columns:95px 1fr}
    }
  </style>
</head>
