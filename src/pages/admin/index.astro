      $('pNoteSave').onclick = async () => { const n = $('pNote').value; try { await api('update', { id: o.id, note: n }); o.internal = n; $('pNoteOk').hidden = false; setTimeout(() => { const e = $('pNoteOk'); if (e) e.hidden = true; }, 2000); } catch { toast('تعذّر الحفظ'); } };
      $('pCopy').onclick = () => { const t = `${o.name}\n${o.phone}${o.phone_extra ? '\nهاتف إضافي: ' + o.phone_extra : ''}${mapURL ? '\n' + mapURL : ''}\n${o.city} – ${o.address}\nالإجمالي: ${o.total} ج.م (${o.payment})\nطلب ${o.id}`; navigator.clipboard?.writeText(t).then(() => toast('تم النسخ'), () => toast('تعذّر النسخ')); };
      $('pBody').querySelectorAll('[data-full]').forEach((b) => b.onclick = async () => {
        b.disabled = true; b.textContent = 'جارٍ التحميل…';
        try { const j = await api('photo', { orderId: o.id, fileId: b.dataset.full }); showImage(j.data, j.name || o.id + '.jpg'); } catch { toast('تعذّر تحميل الصورة'); }
        b.disabled = false; b.textContent = 'عرض بالحجم الكامل';
      });
    }
    function closePanel() { openId = null; $('panel').classList.remove('on'); $('scrim').classList.remove('on'); $('panel').setAttribute('aria-hidden', 'true'); }
    $('pClose').addEventListener('click', closePanel); $('scrim').addEventListener('click', closePanel);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { const lb = document.querySelector('.lightbox'); if (lb) lb.remove(); else closePanel(); } });
    function showImage(src, name) {
      const d = document.createElement('div'); d.className = 'lightbox';
      d.innerHTML = `<button class="btn x">إغلاق</button><div style="display:flex;flex-direction:column;gap:12px;align-items:center"><img src="${src}" alt=""><a class="btn p" download="${esc(name)}" href="${src}">تحميل الصورة</a></div>`;
      d.addEventListener('click', (e) => { if (e.target === d || e.target.classList.contains('x')) d.remove(); });
      document.body.appendChild(d);
    }

    /* ---------- demo data ---------- */
    function demoApi(action, x) {
      if (!demoApi.data) {
        const t = (h) => new Date(Date.now() - h * 3600e3).toISOString();
        const thumb = '/media/products/couple/ref.webp';
        demoApi.data = [
          { id: 'NA-261020-4821', date: t(.2), status: 'جديد', name: 'سارة محمود', phone: '01012345678', city: 'القاهرة', address: 'مدينة نصر، شارع عباس العقاد، عمارة ١٢', payment: 'InstaPay', payment_status: 'Awaiting full payment', phone_extra:'01112345678', location:{lat:30.056,lng:31.345}, items: [{ name: 'لوحة من صورتك', option: '50×60 سم / طولي', qty: 1, line: 2200, custom: true, note: 'احذف الخلفية' }], delivery: 120, total: 2320, notes: '', internal: '', source: 'instagram', photos: [{ id: 'demo', thumb, url: '#' }] },
          { id: 'NA-261020-1937', date: t(1.5), status: 'جديد', name: 'محمد علي', phone: '01198765432', city: 'الجيزة', address: 'الدقي، شارع التحرير ٤٥', payment: 'InstaPay', items: [{ name: 'حلم الورد', option: '40×50 سم', qty: 1, line: 750 }, { name: 'ليلة النجوم', option: '40×50 سم', qty: 1, line: 750 }], delivery: 120, total: 1620, notes: 'الاتصال بعد ٥ مساءً', internal: '', source: 'facebook', photos: [] },
          { id: 'NA-261019-7710', date: t(20), status: 'بانتظار موافقة التصميم', name: 'ندى حسن', phone: '01055512345', city: 'الإسكندرية', address: 'سموحة، شارع فوزي معاذ', payment: 'فودافون كاش', items: [{ name: 'لوحة من صورتك', option: '40×50 سم / عرضي', qty: 1, line: 1800, custom: true }], delivery: 120, total: 1920, notes: '', internal: 'تم إرسال التصميم على واتساب', source: 'instagram', photos: [{ id: 'demo', thumb, url: '#' }] },
          { id: 'NA-261019-3302', date: t(26), status: 'قيد التجهيز', name: 'أحمد سمير', phone: '01234567890', city: 'المنصورة', address: 'شارع الجمهورية', payment: 'الدفع نقدًا عند الاستلام', items: [{ name: 'حقول الغروب', option: '40×50 سم', qty: 2, line: 1500 }], delivery: 120, total: 1620, notes: '', internal: '', photos: [] },
          { id: 'NA-261018-5520', date: t(50), status: 'تم الشحن', name: 'منة الله', phone: '01511122233', city: 'القاهرة', address: 'التجمع الخامس', payment: 'الدفع نقدًا عند الاستلام', items: [{ name: 'صباح على البحر', option: '40×50 سم', qty: 1, line: 750 }], delivery: 120, total: 870, notes: '', internal: 'بوليصة الشحن 88231', photos: [] },
          { id: 'NA-261015-6107', date: t(120), status: 'تم التسليم', name: 'يوسف كمال', phone: '01022233344', city: 'الجيزة', address: 'الشيخ زايد', payment: 'InstaPay', items: [{ name: 'مدينة المظلات', option: '40×50 سم', qty: 1, line: 750 }], delivery: 120, total: 870, notes: '', internal: '', photos: [] },
          { id: 'NA-261012-2214', date: t(200), status: 'ملغي', name: 'هالة فؤاد', phone: '01066677788', city: 'طنطا', address: 'شارع البحر', payment: 'الدفع نقدًا عند الاستلام', items: [{ name: 'حلم الورد', option: '40×50 سم', qty: 1, line: 750 }], delivery: 120, total: 870, notes: '', internal: 'العميل ألغى', photos: [] },
        ];
        // extra sample history so the analytics view has something to show
        const names = ['ريم عادل', 'كريم فتحي', 'مي سامي', 'عمر خالد', 'هبة نبيل', 'مصطفى رأفت', 'ياسمين طارق', 'نور الدين', 'سلمى أشرف', 'آدم حسام'];
        const cities = ['القاهرة', 'الجيزة', 'الإسكندرية', 'القاهرة', 'الجيزة', 'الدقهلية', 'الشرقية', 'القاهرة'];
        const kits = ['حلم الورد', 'صباح على البحر', 'حقول الغروب', 'ليلة النجوم', 'مدينة المظلات'];
        const srcs = ['facebook', 'instagram', 'instagram', '', 'facebook', 'tiktok'];
        const pays = ['الدفع نقدًا عند الاستلام', 'الدفع نقدًا عند الاستلام', 'InstaPay', 'فودافون كاش'];
        let seed = 7; const rnd = () => (seed = (seed * 9301 + 49297) % 233280) / 233280;
        for (let i = 0; i < 34; i++) {
          const h = 30 + rnd() * 1400, custom = rnd() < 0.22, qty = rnd() < 0.2 ? 2 : 1;
          const size = [['40×50 سم / طولي', 1800], ['50×60 سم / عرضي', 2200], ['60×75 سم / طولي', 2800]][Math.floor(rnd() * 3)];
          const item = custom ? { name: 'لوحة من صورتك', option: size[0], qty: 1, line: size[1], custom: true } : { name: kits[Math.floor(rnd() * kits.length)], option: '40×50 سم', qty, line: 750 * qty };
          const st = h > 300 ? (rnd() < 0.1 ? 'ملغي' : 'تم التسليم') : h > 120 ? 'تم الشحن' : 'قيد التجهيز';
          const nm = names[Math.floor(rnd() * names.length)];
          demoApi.data.push({ id: 'NA-DEMO-' + (1000 + i), date: t(h), status: st, name: nm, phone: '010' + String(10000000 + names.indexOf(nm) * 1111111).slice(0, 8), city: cities[Math.floor(rnd() * cities.length)], address: 'عنوان تجريبي', payment: custom ? 'InstaPay' : pays[Math.floor(rnd() * pays.length)], payment_status: custom ? 'Paid in full' : 'Unconfirmed', items: [item], delivery: 120, total: item.line + 120, subtotal: item.line, notes: '', internal: '', source: srcs[Math.floor(rnd() * srcs.length)], photos: [] });
        }
      }
      if (action === 'list') return Promise.resolve({ ok: true, orders: JSON.parse(JSON.stringify(demoApi.data)) });
      if (action === 'confirm_payment') { const o = demoApi.data.find(d => d.id === x.id); o.payment_status = 'Paid in full'; return Promise.resolve({ok:true}); }
      if (action === 'update') { const o = demoApi.data.find((d) => d.id === x.id); if (x.status) o.status = x.status; if (x.note != null) o.internal = x.note; return Promise.resolve({ ok: true }); }
      if (action === 'photo') return Promise.resolve({ ok: true, data: '/media/products/couple/ref.webp', name: 'demo.webp' });
    }

    /* ---------- start ---------- */
    const saved = get(KEY);
    if (DEMO) tryLogin('demo', false);
    else if (saved) tryLogin(saved, true);
    else $('login').hidden = false;
  })();
  </script>
