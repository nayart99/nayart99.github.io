---
import { useT, pick, href, money } from '../lib/site.js';
const { p, lang = 'en' } = Astro.props;
const t = useT(lang);
const badge = p.sold_out ? t('sold_out') : p.sale_until ? pick(p.sale.label, lang) : pick(p.badge, lang);
const soft = (p.badge?.en || '').toLowerCase() === 'new';
---
<a class={`card${p.sold_out ? ' sold' : ''}`} href={href(lang, `/products/${p.slug}`)}>
  <div class="media">
    {badge && <span class={`badge${soft && !p.sold_out && !p.sale_until ? ' soft' : ''}${p.sold_out ? ' sold' : ''}${p.sale_until ? ' deal' : ''}`} data-deal-badge={p.sale_until ? pick(p.badge, lang) || '' : undefined}>{badge}</span>}
    <div class={`frame ${p.landscape ? 'land' : 'port'}`}>
      <img src={p.images.finished} alt={pick(p.name, lang)} loading="lazy" />
      <img class="alt" src={p.images.numbered} alt="" loading="lazy" />
    </div>
  </div>
  <span class="lvl">{pick(p.level, lang)}</span>
  <h3>{pick(p.name, lang)}</h3>
  <div class="cprice" data-card-price={p.slug}><b class="price">{money(p.price, lang)}</b>{p.compare_price > p.price && <s class="price">{money(p.compare_price, lang)}</s>}</div>
  <div class="sub">{t('card_sub')}</div>
</a>
