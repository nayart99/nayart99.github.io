    /* ---------- shipping companies ---------- */
    function noteCourier(o, c) {
      const t = new Date(), stamp = `${String(t.getDate()).padStart(2, '0')}/${String(t.getMonth() + 1).padStart(2, '0')} ${String(t.getHours()).padStart(2, '0')}:${String(t.getMinutes()).padStart(2, '0')}`;
      o.internal = ((o.internal || '') + `\n🚚 ${stamp}: شركة الشحن: ${o.courier ? o.courier + ' ← ' : ''}${c || 'بدون'}`).trim();
      o.courier = c;
    }
    async function saveCourier(list, c) {
      try {
        const j = await api('courier', { ids: list.map((o) => o.id), courier: c });
        list.forEach((o) => { if (o.courier !== c) noteCourier(o, c); o.updated = new Date().toISOString(); });
        if (j.couriers) couriers = j.couriers; else if (c && !couriers.includes(c)) couriers.push(c);
        render(); if (openId) openPanel(openId);
        toast(c ? `🚚 ${list.length > 1 ? list.length + ' طلب' : 'الأوردر'} مع ${c}` : 'اتشالت شركة الشحن');
      } catch (e) { toast(e.message === 'unknown action' ? 'شركات الشحن محتاجة تحديث السيرفر الأول' : 'تعذّر حفظ شركة الشحن'); }
    }
    async function editCouriers() {
      const v = prompt('أسماء شركات الشحن (افصل بينهم بفاصلة):', couriers.join('، '));
      if (v == null) return;
      const list = [...new Set(v.split(/[,،\n]/).map((x) => x.trim()).filter(Boolean))];
      if (!list.length) return toast('لازم شركة واحدة على الأقل');
      try { const j = await api('couriers_save', { couriers: list }); couriers = j.couriers || list; render(); if (openId) openPanel(openId); toast('تم حفظ شركات الشحن'); }
      catch (e) { toast(e.message === 'unknown action' ? 'شركات الشحن محتاجة تحديث السيرفر الأول' : 'تعذّر الحفظ'); }
    }
    /** Shows the companies as big buttons. Resolves the name, null for "skip", undefined if closed. */
    function chooseCourier(title, skipLabel = 'من غير شركة') {
      return new Promise((resolve) => {
        const d = document.createElement('div'); d.className = 'cpick'; d.setAttribute('role', 'dialog'); d.setAttribute('aria-modal', 'true');
        const draw = () => { d.innerHTML = `<div class="cpick-box"><h3>🚚 ${esc(title)}</h3><div class="cpick-list">${couriers.map((c) => `<button type="button" class="btn" data-c="${esc(c)}">${esc(c)}</button>`).join('')}</div>
          <form class="cpick-add"><input class="in" placeholder="شركة تانية؟ اكتب اسمها" maxlength="40"><button class="btn">إضافة</button></form>
          <div class="acts"><button type="button" class="btn" data-skip>${esc(skipLabel)}</button><button type="button" class="btn" data-x>إلغاء</button></div></div>`; };
        const done = (v) => { d.remove(); document.removeEventListener('keydown', esc_); resolve(v); };
        const esc_ = (e) => { if (e.key === 'Escape') { e.stopPropagation(); done(undefined); } };
        draw(); document.body.appendChild(d); document.addEventListener('keydown', esc_);
        d.addEventListener('click', (e) => { const b = e.target.closest('[data-c]'); if (b) return done(b.dataset.c); if (e.target.closest('[data-skip]')) return done(null); if (e.target.closest('[data-x]') || e.target === d) done(undefined); });
        d.addEventListener('submit', (e) => { e.preventDefault(); const v = d.querySelector('.cpick-add .in').value.trim(); if (v) done(v); });
        d.querySelector('[data-c]')?.focus();
      });
    }

