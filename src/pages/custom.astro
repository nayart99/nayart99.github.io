---
import Layout from '../layouts/Layout.astro';
import Custom from '../components/views/Custom.astro';
import { useT, settings, customOn } from '../lib/site.js';
const t = useT('en');
---
<Layout lang="en" path="/custom" noindex={!customOn} title={t('custom_title')} description={t('custom_blurb')} image={settings.custom_example.finished}><Custom lang="en" /></Layout>
